    "@fontsource/russo-one": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.2.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
