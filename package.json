{
  "name": "wellworn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "schema": "node scripts/gen-questionnaire-schema.mjs",
    "pretest:unit": "esbuild tests/questionnaire.test.ts --bundle --platform=node --format=esm --outfile=/tmp/wellworn-questionnaire.test.mjs",
    "test:unit": "node --test /tmp/wellworn-questionnaire.test.mjs",
    "test:browser": "node tests/questionnaire.browser.mjs",
    "test": "pnpm test:unit",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.2.6",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/montserrat": "^5.3.0",
