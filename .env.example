RESEND_API_KEY=
SUBMISSION_TO=nicholas@wellworncreative.com
RESEND_FROM=Wellworn <forms@wellworncreative.com>

# Public and embedded in the questionnaire HTML. Optional in development,
# where the official always-pass Cloudflare test key is used automatically.
# Required in production and must be a real Turnstile widget site key.
PUBLIC_TURNSTILE_SITE_KEY=

# Private. Configure as a Cloudflare Worker secret in production. Optional in
# development, where the matching official test secret is used automatically.
TURNSTILE_SECRET_KEY=
