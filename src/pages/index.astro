---
/**
 * THE HOMEPAGE.
 *
 * Twelve sections in a fixed order, and this file composes them. It holds no
 * copy of its own: every word on the page comes from config/home.ts or
 * config/site.ts, and every piece of layout comes from a component under
 * components/home/. If something on the page needs changing, one of those two
 * places is where to change it.
 *
 * THE ARGUMENT, in order:
 *   promise (the hero, with the client marquee composited on its bottom
 *   edge) → proof (testimonials) → the three things a website owes a business
 *   → how we build → what it costs → what else we do → the ask.
 *
 * THE GROUNDS alternate down the page and are most of what gives it depth,
 * since there are no shadows anywhere: white, white, white, cream, white, cream
 * for the services, then black from pricing all the way down through the extra
 * services, the close, and the footer. The page turns black exactly where it
 * starts asking for something, and stays there.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/home/Hero.astro';
import VideoTestimonials from '../components/home/VideoTestimonials.astro';
import PromiseSection from '../components/home/PromiseSection.astro';
import ServiceCards from '../components/home/ServiceCards.astro';
import PricingSection from '../components/home/PricingSection.astro';
import AdditionalServices from '../components/home/AdditionalServices.astro';
import ClosingCollage from '../components/home/ClosingCollage.astro';
import {
	ADDITIONAL,
	ADDITIONAL_SERVICES,
	CLOSING,
	COLLAGE,
	PRICING,
	PROMISES,
	SERVICE_RAIL,
	SERVICES_INTRO,
	TESTIMONIALS,
	TESTIMONIALS_HEADING,
} from '../config/home';
---

<BaseLayout
	schemaOrg
	description="Wellworn builds websites for small businesses that want to get found, earn trust, and make it easy for customers to do business with them."
>
	{/*
	  The header overlays the hero on this page and on no other. It is the only
	  page that opens on full-bleed media tall enough to carry a bar, and a
	  white band between the navigation and that media is what stops the first
	  screen reading as one composition. Every internal page gets the plain
	  white bar from BaseLayout's default.
	*/}
	<Header slot="header" overlay />

	{/* 1, 2, 3. The client marquee is INSIDE the hero now, on the bottom edge of
	    the footage, rather than being a band of its own beneath it. */}
	<Hero />

	{/*
	  4. This carries the #work fragment the header points at. The testimonials
	  are the closest thing on the page to a body of work — real clients saying
	  what the work did — and sending "Work" to the client marquee in the hero
	  would land a visitor on a strip of marks with nothing to read.
	*/}
	<VideoTestimonials
		testimonials={TESTIMONIALS}
		heading={TESTIMONIALS_HEADING}
		id="work"
	/>

	{/*
	  5, 6, 7. Get found. Earn trust. Make it easy to do business.

	  One component, three bands, alternating side and ground — see the data in
	  config/home.ts, which is where the alternation is decided rather than here.
	*/}
	{PROMISES.map((promise) => <PromiseSection promise={promise} />)}

	{/* 8 */}
	<ServiceCards
		heading={SERVICES_INTRO.heading}
		body={SERVICES_INTRO.body}
		services={SERVICE_RAIL}
		id="services"
	/>

	{/* 9 */}
	<PricingSection
		eyebrow={PRICING.eyebrow}
		heading={PRICING.heading}
		upfront={PRICING.upfront}
		monthly={PRICING.monthly}
		body={PRICING.body}
		features={PRICING.features}
		closing={PRICING.closing}
		portrait={PRICING.portrait}
		portraitAlt={PRICING.portraitAlt}
		ownerName={PRICING.ownerName}
		ownerRole={PRICING.ownerRole}
		id="pricing"
	/>

	{/* 10 */}
	<AdditionalServices
		heading={ADDITIONAL.heading}
		body={ADDITIONAL.body}
		services={ADDITIONAL_SERVICES}
	/>

	{/* 12 */}
	<ClosingCollage lines={CLOSING.lines} tiles={COLLAGE} />

	{/* 13 — the footer comes from BaseLayout. */}
</BaseLayout>
