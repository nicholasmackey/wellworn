---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCta from '../components/ContactCta.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PHOTOGRAPHY } from '../config/site';
import bandImage from '../assets/photography/real-estate/service-real-estate.jpg';
import exteriorElevation from '../assets/photography/real-estate/exterior-elevation-dusk.jpg';
import interiorLivingRoom from '../assets/photography/real-estate/interior-living-room.jpg';
import interiorStudy from '../assets/photography/real-estate/interior-study.jpg';
import deliveryOnPhone from '../assets/photography/real-estate/delivery-listing-on-phone.jpg';

/**
 * One photograph per capability, keyed by the item label it sits under, so
 * each frame is the evidence for the claim directly above it. Labels are
 * unique across both services, so the label alone is enough of a key.
 *
 * "Ready to use" is about delivery rather than a subject, so its frame shows
 * the finished file in use instead of another property. Nothing is captioned
 * on screen — a label under a photograph only repeats what the viewer can
 * already see. `alt` is still written for screen readers and for a failed
 * load; it is never rendered visually.
 */
const ITEM_PHOTOS: Record<string, { src: ImageMetadata; alt: string }> = {
	Interiors: {
		src: interiorStudy,
		alt: 'A study with a long timber desk running beneath a bank of windows, dark wood floors, and a full bookcase in the foreground.',
	},
	Exteriors: {
		src: exteriorElevation,
		alt: 'A black board-and-batten house photographed head on at dusk, its windows and glazed doors lit from within against the treeline behind it.',
	},
	Architecture: {
		src: interiorLivingRoom,
		alt: 'A stone chimney breast and timber mantel rising to a boarded ceiling, flanked by tall windows and a lit fire.',
	},
	'Ready to use': {
		src: deliveryOnPhone,
		alt: 'A hand holding a phone up to a gabled house in autumn, the finished photograph of that house filling the screen.',
	},
};

/**
 * Galleries. Empty until there are shoots to publish — the section below
 * renders the grid when this list has entries and an honest placeholder when
 * it doesn't, so publishing the first gallery is a data change, not a rebuild.
 * `image` is a path under /public: /images/photography/real-estate/… for
 * property work, /images/photography/general/… for everything else.
 */
interface Gallery {
	readonly title: string;
	readonly category: string;
	readonly year?: string;
	readonly image?: string;
	readonly imageAlt?: string;
	readonly href?: string;
}

const GALLERIES: readonly Gallery[] = [];
---

<BaseLayout
	title="Real estate and commercial photography"
	description="Wellworn photographs properties, businesses, and brands. Interiors, exteriors, architecture, portraits, products, and spaces."
>
	<section class="wrapper pt-24 pb-16 lg:pt-32 lg:pb-20">
		<h1 class="max-w-4xl text-4xl leading-[1.1] sm:text-5xl lg:text-6xl">
			Make a better first impression.
		</h1>

		<p class="mt-8 max-w-2xl text-lg leading-relaxed text-charcoal/70 sm:text-xl">
			Wellworn photographs properties, businesses, and brands with a focus on clarity, light,
			and the details people notice.
		</p>

		<p class="mt-6 max-w-2xl leading-relaxed text-charcoal/70">
			For listings, websites, print, and everything in between.
		</p>
	</section>

	{/* Full-bleed band. The page leads with a photograph rather than a paragraph. */}
	<Image
		src={bandImage}
		alt="A modern barn-style home photographed at dusk, its windows lit from within, set against a treeline above a gravel drive."
		widths={[640, 960, 1280, 1600, 1920, 2560]}
		sizes="100vw"
		quality={80}
		class="h-[24rem] w-full object-cover sm:h-[30rem] lg:h-[38rem]"
	/>

	{/*
	  Both services live on this page, anchored by slug — the structured data
	  links straight to these ids. `scroll-padding-top` in global.css keeps the
	  sticky header clear of the heading.

	  No "Services" label above these: after the photograph, the page makes the
	  case rather than announcing a section. That leaves each service headline
	  as the h2 directly under the page h1, which is also the honest hierarchy.
	*/}
	<div class="wrapper py-20 space-y-16 lg:py-28 lg:space-y-24">
		{
			PHOTOGRAPHY.services.map((service) => {
				/* Photographed services carry a third subgrid row for the image.
				   Spanning three rows unconditionally would leave a `gap-y` band
				   below the services that have no photographs yet. */
				const hasPhotos = service.items.some((item) => item.label in ITEM_PHOTOS);

				return (
				<article id={service.slug} class="border-t border-charcoal/40 pt-8">
					<h2 class="max-w-2xl text-2xl leading-snug sm:text-3xl">{service.headline}</h2>

					{/* The plain service name, in the eyebrow the section label used to
					    occupy — the headline promises, this says which service keeps it. */}
					<p class="mt-4 eyebrow text-charcoal/60">{service.title}</p>

					<p class="mt-6 max-w-xl text-lg leading-relaxed text-charcoal/70">
						{service.description}
					</p>

					{/* Subgridded so a label that wraps onto a second line pushes every
					    note in its row down together, and every photograph in the row
					    still starts from the same line. Column count follows the item
					    count so the last row never ends in a stray rule over empty
					    space. */}
					<dl
						class:list={[
							'mt-12 grid gap-x-8 gap-y-8 sm:grid-cols-2',
							service.items.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4',
						]}
					>
						{service.items.map((item) => {
							const photo = ITEM_PHOTOS[item.label];

							return (
								<div
									class:list={[
										'grid grid-rows-subgrid gap-y-0 border-t border-charcoal/20 pt-4',
										hasPhotos ? 'row-span-3' : 'row-span-2',
									]}
								>
									<dt class="eyebrow text-charcoal">{item.label}</dt>
									<dd class="mt-3 text-sm leading-relaxed text-charcoal/70">{item.note}</dd>

									{/* A second `dd` rather than a wrapper element: only `dt` and
									    `dd` are valid inside a `dl` row, and the separate row is
									    what keeps the images aligned across the grid. */}
									{photo && (
										<dd class="mt-6 self-end">
											<Image
												src={photo.src}
												alt={photo.alt}
												widths={[320, 440, 560, 760, 960]}
												sizes="(min-width: 80rem) 272px, (min-width: 1024px) 22vw, (min-width: 640px) 46vw, 92vw"
												quality={80}
												class="aspect-3/2 w-full object-cover"
											/>
										</dd>
									)}
								</div>
							);
						})}
					</dl>
				</article>
				);
			})
		}
	</div>

	{/* No placeholder: the section stays out of the page until there are
	    galleries in it, rather than explaining its own absence. */}
	{
		GALLERIES.length > 0 && (
			<section class="wrapper pb-20 lg:pb-28" aria-labelledby="galleries-heading">
				<div class="border-t border-charcoal/40 pt-8">
					<h2 id="galleries-heading" class="eyebrow text-charcoal/60">
						Galleries
					</h2>

					<div class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
						{GALLERIES.map((gallery) => (
							<ProjectCard
								title={gallery.title}
								category={gallery.category}
								year={gallery.year}
								image={gallery.image}
								imageAlt={gallery.imageAlt}
								href={gallery.href}
								aspect="3/2"
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<ContactCta heading="Give people something worth seeing." body="Tell us how we can help." />
</BaseLayout>
