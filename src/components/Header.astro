---
import { NAV } from '../config/site';
import Wordmark from './Wordmark.astro';

interface Props {
	/** Extra classes for the outer <header>. */
	class?: string;
}

const { class: className = '' }: Props = Astro.props;

const currentPath = Astro.url.pathname;

/** A nav item is current only when it points at a real route, not a fragment. */
const isCurrent = (href: string): boolean => !href.includes('#') && href === currentPath;
---

<header
	class:list={[
		'sticky top-0 z-50 border-b border-charcoal/10 bg-cream/95 backdrop-blur-sm',
		className,
	]}
>
	<div class="wrapper flex h-20 items-center justify-between gap-8">
		<a href="/" class="shrink-0 transition-opacity duration-200 hover:opacity-70">
			<Wordmark animate class="h-9 w-auto text-charcoal sm:h-10" />
		</a>

		<nav aria-label="Primary" class="hidden items-center gap-10 md:flex">
			{
				NAV.map((item) => (
					<a
						href={item.href}
						aria-current={isCurrent(item.href) ? 'page' : undefined}
						class="eyebrow text-charcoal/70 transition-colors duration-200 hover:text-charcoal aria-[current=page]:text-charcoal"
					>
						{item.label}
					</a>
				))
			}
			<a href="/#contact" class="btn btn-outline">Get in touch</a>
		</nav>

		<button
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="mobile-nav"
			class="group -mr-3 inline-flex h-11 w-11 items-center justify-center md:hidden"
		>
			<span class="sr-only">Menu</span>
			{/* Two bars that meet in the middle and cross into an X when open. */}
			<span aria-hidden="true" class="relative block h-[7px] w-6">
				<span
					class="absolute inset-x-0 top-0 h-px bg-charcoal transition-transform duration-200 group-aria-expanded:translate-y-[3px] group-aria-expanded:rotate-45"
				></span>
				<span
					class="absolute inset-x-0 bottom-0 h-px bg-charcoal transition-transform duration-200 group-aria-expanded:-translate-y-[3px] group-aria-expanded:-rotate-45"
				></span>
			</span>
		</button>
	</div>

	{/*
	  Collapsed with grid-template-rows 0fr -> 1fr so the panel animates to its
	  natural height without hard-coding one. `hidden` can't be used here — it
	  would skip the transition — so the closed panel is made `inert` instead,
	  which takes it out of the tab order and the accessibility tree.

	  The middle div only exists to collapse. `min-h-0` clears the automatic
	  minimum an fr row would otherwise floor at, but padding and borders are
	  not part of what it lets shrink, so all spacing has to sit on the <nav>
	  inside it — otherwise the closed panel keeps padding a stripe of height
	  onto the header.
	*/}
	<div
		id="mobile-nav"
		data-nav-panel
		inert
		class="grid grid-rows-[0fr] overflow-hidden bg-cream opacity-0 transition-[grid-template-rows,opacity] duration-200 md:hidden data-[open]:grid-rows-[1fr] data-[open]:opacity-100"
	>
		<div class="min-h-0">
			<nav
				aria-label="Primary (mobile)"
				class="wrapper flex flex-col border-t border-charcoal/10 py-4"
			>
				{
					NAV.map((item) => (
						<a
							href={item.href}
							aria-current={isCurrent(item.href) ? 'page' : undefined}
							class="eyebrow border-b border-charcoal/10 py-4 text-charcoal"
						>
							{item.label}
						</a>
					))
				}
				<a href="/#contact" class="btn btn-primary mt-6">Get in touch</a>
			</nav>
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
	const panel = document.querySelector<HTMLElement>('[data-nav-panel]');

	if (toggle && panel) {
		const setOpen = (open: boolean): void => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.toggleAttribute('data-open', open);
			panel.inert = !open;
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Close after tapping a link — same-page anchors don't trigger navigation.
		panel.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
				setOpen(false);
				toggle.focus();
			}
		});

		// Reset state if the viewport grows past the mobile breakpoint.
		const desktop = window.matchMedia('(min-width: 48rem)');
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	}
</script>
