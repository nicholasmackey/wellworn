---
import { NAV, SITE } from '../config/site';
import Wordmark from './Wordmark.astro';

interface Props {
	/** Extra classes for the outer <header>. */
	class?: string;
}

const { class: className = '' }: Props = Astro.props;

/** 01, 02, 03 — the same index the process list upstairs is numbered with. */
const ordinal = (index: number): string => String(index + 1).padStart(2, '0');
---

{/*
  The header holds the mark and one control. That control used to be the "Get
  in touch" button, which made the header say the same thing the hero, the
  close, and the footer were already saying, and left the other six sections of
  a very long single page reachable only by scrolling. It is a menu now, and
  contact is the last row in it.

  The panel is a sibling of <header>, not a child, and has to be: the header
  carries backdrop-blur, and a backdrop-filter makes an element the containing
  block for its fixed descendants — a fixed panel inside it would be laid out
  against the 5rem bar instead of the viewport. Kept in this component anyway,
  because the button and the panel are one control.
*/}
<header
	data-site-header
	class:list={[
		'sticky top-0 z-50 border-b border-charcoal/10 bg-cream/95 backdrop-blur-sm',
		'transition-colors duration-300',
		className,
	]}
>
	<div class="wrapper flex h-20 items-center justify-between gap-4 sm:gap-8">
		{/* The colour lives on the link rather than on the <svg>, so the mark
		    inherits it through currentColor and flips to cream with the rest of
		    the bar when the menu is open. */}
		<a
			href="/"
			class="brand-link shrink-0 text-charcoal transition-opacity duration-200 hover:opacity-70"
		>
			<Wordmark animate class="h-8 w-auto sm:h-10" />
		</a>

		{/* -mr-3 pulls the 48px tap target's padding back so the bars line up with
		    the wrapper gutter rather than sitting an eighth of an inch inside it. */}
		<button
			type="button"
			id="menu-toggle"
			class="menu-toggle -mr-3 shrink-0"
			aria-controls="site-menu"
			aria-expanded="false"
		>
			<span class="sr-only">Menu</span>

			<span class="bars" aria-hidden="true">
				<span class="bar"></span>
				<span class="bar"></span>
				<span class="bar"></span>
			</span>
		</button>
	</div>
</header>

{/*
  The menu. Charcoal, like the two panels on the page that make its flattest
  claims, and it opens as an index rather than a list of links: rule, number,
  name, and the line saying what is down there — the same four parts, in the
  same order, as the capabilities index in #services.

  What it is built out of is the point. Every section on the page opens with a
  rule that draws and a heading; the wordmark opens by drawing its box and
  wiping its letters in left to right. So the menu opens the same way, five
  times over: each rust rule draws from the left, each name wipes in behind it
  on the wordmark's own curve, and the rows resolve in page order 70ms apart.
  Nothing here is a generic slide-in — it is the site's own entrance, repeated.
*/}
<nav id="site-menu" class="site-menu" aria-label="Sections" inert>
	<div class="wrapper flex min-h-full flex-col pt-24 pb-10 sm:pt-28 lg:pb-14">
		<ul>
			{
				NAV.map((item, index) => (
					<li class="menu-row" style={`--row:${index}`}>
						<a href={item.href} class="menu-link">
							{/* The rule is the row's own element rather than a border, because a
							    border cannot be drawn: this one scales out from its left edge. */}
							<span class="menu-rule" aria-hidden="true" />

							<span class="menu-lead">
								{/* Stone, not rust. Rust is the accent that opens every section on
								    the page, but at 3.6:1 on charcoal it is a rule colour and never
								    type — least of all 12px type. Stone clears 6.1:1 here. */}
								<span class="menu-index eyebrow" aria-hidden="true">
									{ordinal(index)}
								</span>

								<span class="menu-name display">{item.label}</span>
							</span>

							<span class="menu-note">{item.note}</span>
						</a>
					</li>
				))
			}
		</ul>

		{/* The rule that closes the index, the way the capability list closes
		    itself downstairs. It is the sixth row as far as the stagger is
		    concerned, so it draws last and the menu finishes on the same gesture
		    it started with. */}
		<span class="menu-rule menu-rule-close" style={`--row:${NAV.length}`} aria-hidden="true"
		></span>

		{/* mt-auto rather than a margin: the index sits under the header where it
		    was dealt, and this settles to the foot of whatever screen it lands on.
		    The same address the footer carries, for anyone who would rather not
		    scroll to a form. */}
		<div class="menu-foot mt-auto pt-12">
			<p class="eyebrow text-stone">Or just email us</p>

			<p class="mt-4">
				<a
					href={`mailto:${SITE.email}`}
					class="text-lg text-cream underline decoration-stone/60 underline-offset-4 transition-colors duration-200 hover:decoration-rust focus-visible:outline-cream sm:text-xl"
				>
					{SITE.email}
				</a>
			</p>
		</div>
	</div>
</nav>

<style>
	/* ======================================================================
	   The toggle

	   Three bars that behave like the rules everywhere else on this site:
	   they draw from the left. Resting on it wipes them in one after another,
	   55ms apart — the wordmark's letter stagger at a twelfth of the size —
	   and opening the menu retracts the middle one to the left before the
	   outer two swing across it.
	   ====================================================================== */
	.menu-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		color: var(--color-charcoal);
		transition: color 300ms ease;
		cursor: pointer;
	}

	.bars {
		position: relative;
		display: block;
		width: 26px;
		height: 14px;
	}

	.bar {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: currentColor;
		transform-origin: left center;
		transition: transform 220ms cubic-bezier(0.65, 0, 0.35, 1);
	}

	.bar:nth-child(1) {
		top: 0;
	}

	.bar:nth-child(2) {
		top: 6px;
	}

	.bar:nth-child(3) {
		top: 12px;
	}

	/* The hover wipe, and the reason it is an animation rather than a
	   transition: a transition can only travel between two states, so it plays
	   once and then has nowhere left to go. This has to re-run on every
	   approach. Closed only — there are no bars to wipe once they are an X. */
	html:not([data-menu-open]) .menu-toggle:hover .bar {
		animation: bar-wipe 300ms cubic-bezier(0.33, 1, 0.68, 1) backwards;
	}

	html:not([data-menu-open]) .menu-toggle:hover .bar:nth-child(2) {
		animation-delay: 55ms;
	}

	html:not([data-menu-open]) .menu-toggle:hover .bar:nth-child(3) {
		animation-delay: 110ms;
	}

	@keyframes bar-wipe {
		from {
			transform: scaleX(0);
		}
	}

	/* Open: the middle bar goes first, back out the way it came, and the outer
	   two follow it across once it is clear. They rotate about their centres so
	   the X actually crosses; the middle keeps the left origin every rule on
	   this site has. */
	html[data-menu-open] .bar {
		transition-duration: 300ms;
	}

	html[data-menu-open] .bar:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
		transform-origin: center;
		transition-delay: 90ms;
	}

	html[data-menu-open] .bar:nth-child(2) {
		transform: scaleX(0);
		transition-duration: 180ms;
	}

	html[data-menu-open] .bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
		transform-origin: center;
		transition-delay: 90ms;
	}

	/* ======================================================================
	   The header, while the menu is open

	   The bar keeps the mark and the toggle and loses everything else: no
	   ground, no blur, no hairline. The charcoal behind it is the panel, so
	   the two read as one field with the mark sitting on it.
	   ====================================================================== */
	html[data-menu-open] [data-site-header] {
		background-color: transparent;
		border-color: transparent;
		backdrop-filter: none;
	}

	html[data-menu-open] .brand-link,
	html[data-menu-open] .menu-toggle {
		color: var(--color-cream);
	}

	/* ======================================================================
	   The panel

	   Everything is a transition off one attribute on <html> rather than a set
	   of keyframes, which buys the exit for free: closing is the same journey
	   with shorter timings and no stagger, so the menu never disassembles
	   itself slowly in front of someone who has already decided to leave.

	   visibility is what takes it out of the a11y tree and out of hit testing
	   at rest; it is transitioned with a delay so it holds until the wipe is
	   finished. The script also flips `inert` on it, which is what keeps the
	   rows out of the tab order — belt and braces, and cheap.
	   ====================================================================== */
	.site-menu {
		position: fixed;
		inset: 0;
		z-index: 40;
		overflow-y: auto;
		overscroll-behavior: contain;
		background-color: var(--color-charcoal);
		color: var(--color-cream);
		visibility: hidden;
		clip-path: inset(0 0 100% 0);
		transition:
			clip-path 300ms cubic-bezier(0.65, 0, 0.35, 1),
			visibility 0s linear 300ms;
	}

	html[data-menu-open] .site-menu {
		visibility: visible;
		clip-path: inset(0 0 0 0);
		transition:
			clip-path 480ms cubic-bezier(0.65, 0, 0.35, 1),
			visibility 0s;
	}

	.menu-link {
		position: relative;
		display: grid;
		gap: 0.5rem 3rem;
		padding-block: 1.125rem;
		align-items: baseline;
	}

	@media (min-width: 48rem) {
		.menu-link {
			grid-template-columns: minmax(0, 1fr) 22rem;
			padding-block: 1.75rem;
		}
	}

	.menu-rule {
		position: absolute;
		inset-inline: 0;
		top: 0;
		height: 1px;
		background-color: var(--color-rust);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform 180ms ease-in;
	}

	/* The closing rule is the same object in the flow rather than pinned to the
	   top of a row, so it inherits every other property — colour, origin, the
	   draw itself — from the rule above. */
	.menu-rule-close {
		position: static;
		display: block;
		width: 100%;
	}

	.menu-lead {
		display: flex;
		align-items: baseline;
		gap: 1rem;
	}

	.menu-index {
		flex-shrink: 0;
		color: var(--color-stone);
		opacity: 0;
		transition: opacity 150ms ease-in;
	}

	/* The wipe. A mask sweeping left to right across a stationary word is
	   exactly what the wordmark's letters do, and clip-path is the same idea
	   with none of the SVG: the glyphs never move, the reveal does. The
	   vertical insets are negative so the box can never shave an overhang off
	   a letter at rest. */
	.menu-name {
		display: block;
		font-size: clamp(1.75rem, 1rem + 3.6vw, 3.25rem);
		line-height: 1;
		clip-path: inset(-0.3em 100% -0.3em 0);
		transition:
			clip-path 160ms ease-in,
			transform 300ms ease-out;
	}

	.menu-note {
		color: color-mix(in oklab, var(--color-cream) 60%, transparent);
		line-height: 1.6;
		opacity: 0;
		transition:
			opacity 150ms ease-in,
			color 300ms ease;
	}

	@media (min-width: 48rem) {
		.menu-note {
			text-align: right;
		}
	}

	.menu-foot {
		opacity: 0;
		transition: opacity 150ms ease-in;
	}

	/* --row is the row's place in the page, set in the markup, and it is the
	   only thing that differs between the five: the rule draws, the number
	   arrives, the name wipes in behind the rule, and the whole row is 70ms
	   behind the one above it, so the menu resolves top to bottom in the order
	   the sections themselves appear. */
	html[data-menu-open] .menu-rule {
		transform: scaleX(1);
		transition: transform 420ms cubic-bezier(0.65, 0, 0.35, 1)
			calc(120ms + var(--row) * 70ms);
	}

	html[data-menu-open] .menu-index {
		opacity: 1;
		transition: opacity 300ms ease-out calc(200ms + var(--row) * 70ms);
	}

	html[data-menu-open] .menu-name {
		clip-path: inset(-0.3em 0 -0.3em 0);
		transition:
			clip-path 520ms cubic-bezier(0.33, 1, 0.68, 1)
				calc(200ms + var(--row) * 70ms),
			transform 300ms ease-out;
	}

	html[data-menu-open] .menu-note {
		opacity: 1;
		transition:
			opacity 400ms ease-out calc(300ms + var(--row) * 70ms),
			color 300ms ease;
	}

	html[data-menu-open] .menu-foot {
		opacity: 1;
		transition: opacity 400ms ease-out 620ms;
	}

	/* The row answering a pointer: the name steps in from the margin and the
	   line beside it comes up out of the muted grey, the same acknowledgement
	   the capability rows make in #services. */
	@media (hover: hover) {
		.menu-link:hover .menu-name {
			transform: translateX(0.375rem);
		}

		.menu-link:hover .menu-note {
			color: color-mix(in oklab, var(--color-cream) 90%, transparent);
		}
	}

	.menu-link:focus-visible {
		outline: 2px solid var(--color-cream);
		outline-offset: 4px;
	}

	/* The global reduce rule collapses durations but leaves delays alone, which
	   would hold every row invisible for its share of the stagger and then snap
	   it in. Drop the delays too, and the menu simply is open or is not. */
	@media (prefers-reduced-motion: reduce) {
		.site-menu,
		.site-menu *,
		.bar {
			transition-delay: 0ms !important;
			animation: none !important;
		}
	}
</style>

<script>
	/*
	  One attribute on <html> is the whole state: the panel, the header's
	  colours, the bars and the scroll lock all key off it, so nothing can end
	  up half open. Everything else here is the part CSS cannot do — telling
	  assistive tech what the button did, keeping the tab order inside the
	  panel, and putting focus back where it came from.
	*/
	const root = document.documentElement;
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('site-menu');

	if (toggle && menu) {
		/* The page behind the panel. Made inert while it is open so tabbing
		   cannot wander into a section nobody can see. The header is left out on
		   purpose: the mark and the close button are still on screen and still
		   have to be reachable. */
		const behind = document.querySelectorAll<HTMLElement>('main, footer, a[href="#main"]');

		const isOpen = () => root.hasAttribute('data-menu-open');

		const setOpen = (open: boolean, restoreFocus = true) => {
			root.toggleAttribute('data-menu-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			menu.toggleAttribute('inert', !open);
			behind.forEach((el) => el.toggleAttribute('inert', open));

			if (open) {
				/* preventScroll, or the panel jumps to put the first row where the
				   browser thinks focus should be — mid-wipe. */
				menu.querySelector('a')?.focus({ preventScroll: true });
			} else if (restoreFocus) {
				toggle.focus({ preventScroll: true });
			}
		};

		toggle.addEventListener('click', () => setOpen(!isOpen()));

		/* Closed without restoring focus: the browser is about to move to the
		   section this link points at, and dragging focus back up to the button
		   would undo that for anyone on a keyboard. Closing first is also what
		   releases the scroll lock in time for the jump to happen at all. */
		menu.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false, false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) setOpen(false);
		});
	}
</script>
