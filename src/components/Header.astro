---
import { CONTACT_HREF } from '../config/site';
import Wordmark from './Wordmark.astro';

interface Props {
	/** Extra classes for the outer <header>. */
	class?: string;
}

const { class: className = '' }: Props = Astro.props;
---

{/*
  There is one page and one destination, so there is no primary nav and
  nothing for a mobile menu to hold: the wordmark goes home, the button goes
  to the form. The collapsing panel and the script that drove it came out
  with the discipline pages.
*/}
<header
	class:list={[
		'sticky top-0 z-50 border-b border-charcoal/10 bg-cream/95 backdrop-blur-sm',
		className,
	]}
>
	<div class="wrapper flex h-20 items-center justify-between gap-4 sm:gap-8">
		<a href="/" class="shrink-0 transition-opacity duration-200 hover:opacity-70">
			<Wordmark animate class="h-8 w-auto text-charcoal sm:h-10" />
		</a>

		{/* The same primary control as the hero CTA, inverted for the cream
		    header: charcoal fill here, cream fill there. It used to be an outline
		    button, which made the site's one destination look like two different
		    offers depending on where you happened to see it. */}
		{/* Full px-7 overflows a 320px screen once the wordmark is beside it, so
		    the side padding (and only the side padding) is trimmed below 360px.
		    Height, fill and radius stay identical to every other primary. */}
		<a href={CONTACT_HREF} class="btn btn-primary shrink-0 px-4 min-[360px]:px-7"
			>Get in touch</a
		>
	</div>
</header>
