---
/**
 * The site header.
 *
 * A white bar, a wordmark, three words, and one action. That is the whole of
 * it, and the restraint is the design: the reference this site is built
 * against puts a short row of plain nouns against a flat white ground and lets
 * the page underneath do the talking. There is no mega menu, no icon set and
 * no dropdown, and adding any of them would be the first step back towards a
 * navigation bar that needs its own navigation.
 *
 * Below the `lg` breakpoint the three words fold into a panel behind a
 * toggle. The action does not fold with them: "Start a project" stays in the
 * bar at every width, because the one thing a visitor might want to do from
 * anywhere on the page should never be two taps away.
 *
 * TWO MODES, one bar. By default it is that white bar, sticky, with a hairline
 * under it. With `overlay` it is fixed and transparent and sits ON the page's
 * hero rather than above it — the reference runs its wordmark and nav directly
 * over the hero footage with no white band between them, and a white band is
 * exactly what makes a full-bleed hero read as a picture placed under a
 * website instead of as the first screen of one. Once the hero has scrolled
 * past, the bar takes its normal white surface back.
 *
 * The overlay is for a page that opens on full-bleed media and nothing else.
 * Every internal page keeps the plain white bar, because a transparent header
 * over a white page is an invisible header.
 */
import { CONTACT_HREF, CTA_LABEL, NAV, SITE } from '../config/site';
import Wordmark from './Wordmark.astro';

interface Props {
	/** Extra classes for the outer <header>. */
	class?: string;
	/**
	 * Sit the bar on top of the page's hero rather than above it: fixed,
	 * transparent, white type, no hairline. Only for a page whose first element
	 * is full-bleed media tall enough to hold it.
	 */
	overlay?: boolean;
}

const { class: className = '', overlay = false }: Props = Astro.props;
---

{/*
  `data-solid` is rendered ON and taken off again by the inline script below,
  so the no-JavaScript rendering of an overlay header is the ordinary white bar
  rather than white type on a white page. The script runs during parse, before
  the bar has been painted once, so there is no flash of the solid state.
*/}
<header
	class:list={['ww-header', className]}
	data-overlay={overlay ? '' : undefined}
	data-solid={overlay ? '' : undefined}
>
	<div class="ww-header-inner">
		{/* The colour lives on the link rather than on the <svg>, so the mark
		    inherits it through currentColor. The wordmark is supplied artwork and
		    is not redrawn here; only its size and colour are this file's
		    business. */}
		<a href="/" class="ww-header-brand" aria-label={`${SITE.name}, home`}>
			<Wordmark class="ww-header-mark" />
		</a>

		<nav class="ww-header-nav" aria-label="Main">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div class="ww-header-actions">
			<a href={CONTACT_HREF} class="ww-btn ww-btn-dark ww-header-cta">{CTA_LABEL}</a>

			{/* The toggle is last in the DOM so that a keyboard user reaching it has
			    already passed the brand and the action, and the panel it opens is
			    the very next thing in the tab order. */}
			<button
				type="button"
				class="ww-header-toggle"
				aria-controls="site-menu"
				aria-expanded="false"
				data-menu-toggle
			>
				<span class="ww-sr-only">Menu</span>
				<span class="ww-header-bars" aria-hidden="true">
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>

	{/*
	  The mobile panel. A sibling of the bar inside the same sticky header, so it
	  hangs off the bottom of it and the bar stays put behind it.

	  `inert` while closed rather than `display: none`, because it has to be
	  animatable AND unreachable, and only one of those comes free with the
	  other. Everything inside it — links, the action — is taken out of the tab
	  order and hidden from assistive tech by the one attribute.
	*/}
	<div id="site-menu" class="ww-header-panel" inert>
		<nav aria-label="Main, expanded">
			<ul>
				{
					NAV.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

{
	/*
	  Two lines, inline and synchronous, and they have to be both.

	  The bar is rendered `data-solid` so that a page with no JavaScript gets
	  the readable white header rather than white type over whatever the hero
	  section turns out to be. Taking the attribute off is therefore the FIRST
	  thing that has to happen, before the browser has painted the bar once —
	  and a bundled <script> cannot do that, because Astro emits it as a module,
	  modules are deferred, and deferred means "after the document is parsed",
	  which is comfortably after the first paint of a header sitting at the top
	  of the body. Hence is:inline.

	  It cannot do the rest of the work either: at this point in the parse the
	  <main> below has not been seen yet, so there is no hero element to observe
	  and nothing to measure. That half lives in the deferred script at the
	  bottom of this file, which runs once the page exists.
	*/
	overlay && (
		<script is:inline>
			document.querySelector('.ww-header[data-overlay]')?.removeAttribute('data-solid');
		</script>
	)
}

<style>
	/*
	  Sticky rather than fixed: the page below scrolls under it and nothing has
	  to be padded down to make room. The hairline underneath is the only edge
	  it has — there is no shadow, and there is no blur.
	*/
	.ww-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background-color: var(--ww-white);
		border-bottom: 1px solid var(--ww-hairline-light);
	}

	/* ======================================================================
	   THE OVERLAY.

	   `fixed`, not `sticky`. Sticky reserves its own height in the flow, which
	   would push a 100svh hero down by a header and give the page a scrollbar
	   before anything has been scrolled. Fixed takes the bar out of the flow
	   entirely so the hero starts at the top of the viewport and ends at the
	   bottom of it, and the bar floats on top — which is the composition being
	   matched.

	   Everything below transitions, so the arrival of the white surface on
	   scroll is a fade rather than a snap.
	   ====================================================================== */
	.ww-header[data-overlay] {
		position: fixed;
		inset-inline: 0;
		background-color: transparent;
		border-bottom-color: transparent;
		transition:
			background-color var(--dur-base) var(--ease-out),
			border-bottom-color var(--dur-base) var(--ease-out);
	}

	/*
	  White type, and it is the hero's scrim that makes it legible rather than
	  anything drawn here. The hero's top gradient sits at ~30% black behind
	  this bar, which holds white at better than 14:1 over even a blown-out
	  frame — so the bar needs no scrim, no blur and no ground of its own.
	*/
	.ww-header[data-overlay]:not([data-solid]) :is(.ww-header-brand, .ww-header-toggle),
	.ww-header[data-overlay]:not([data-solid]) .ww-header-nav a {
		color: var(--ww-white);
	}

	/* The nav's hover is the site blue on white, which over footage is both
	   hard to see and the one colour this page holds in reserve. Over media it
	   dims instead. */
	.ww-header[data-overlay]:not([data-solid]) .ww-header-nav a:hover {
		color: var(--ww-white);
		opacity: 0.7;
	}

	/* The action inverts with the bar: a black pill on dark footage is a hole,
	   and the reference puts the light pill in this position over media. It
	   goes back to black the moment the white surface arrives. */
	.ww-header[data-overlay]:not([data-solid]) .ww-header-cta {
		background-color: var(--ww-white);
		border-color: var(--ww-white);
		color: var(--ww-ink);
	}

	.ww-header[data-overlay]:not([data-solid]) .ww-header-cta:hover {
		background-color: var(--ww-light);
		border-color: var(--ww-light);
	}

	/*
	  The closed phone panel draws a 1px white line across the bottom of a
	  transparent bar, and it is not a border — the panel's own white background
	  paints under its transparent 1px border-top, which is invisible against a
	  white header and a bright hairline against footage. It only has a ground
	  worth having once it is open.
	*/
	.ww-header[data-overlay]:not([data-solid]) .ww-header-panel:not([data-open]) {
		background-color: transparent;
	}

	/* Scrolled past the hero — the ordinary bar, restored. */
	.ww-header[data-overlay][data-solid] {
		background-color: var(--ww-white);
		border-bottom-color: var(--ww-hairline-light);
	}

	/*
	  And the same while the phone menu is open. The panel is a white sheet
	  hanging off the bottom of the bar; leaving the bar transparent above it
	  would put white links on white in the panel's own shadow line and leave
	  the wordmark floating over footage with a white sheet beneath it.
	*/
	.ww-header[data-overlay]:has(.ww-header-panel[data-open]) {
		background-color: var(--ww-white);
		border-bottom-color: var(--ww-hairline-light);
	}

	.ww-header[data-overlay]:has(.ww-header-panel[data-open])
		:is(.ww-header-brand, .ww-header-toggle) {
		color: var(--ww-ink);
	}

	.ww-header[data-overlay]:has(.ww-header-panel[data-open]) .ww-header-cta {
		background-color: var(--ww-ink);
		border-color: var(--ww-ink);
		color: var(--ww-white);
	}

	@media (prefers-reduced-motion: reduce) {
		.ww-header[data-overlay] {
			transition: none;
		}
	}

	.ww-header-inner {
		width: 100%;
		max-width: calc(var(--container-max) + var(--gutter) * 2);
		margin-inline: auto;
		padding-inline: var(--gutter);
		height: var(--header-h);
		display: flex;
		align-items: center;
		gap: var(--space-lg);
	}

	.ww-header-brand {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		color: var(--ww-ink);
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.ww-header-brand:hover {
		opacity: 0.7;
	}

	/*
	  :global, and it has to be. The wordmark is an inline <svg> rendered by
	  Wordmark.astro, which takes a `class` but does not spread the rest of its
	  props — so Astro's scoping attribute never reaches the element, and a
	  scoped rule here would match nothing. The artwork carries width="2476" on
	  itself, so "matches nothing" means a 2476px logo across the page rather
	  than a subtle miss.

	  The class name is specific enough to this component that globalising it
	  costs nothing.
	*/
	:global(.ww-header-mark) {
		height: 22px;
		width: auto;
	}

	@media (min-width: 768px) {
		:global(.ww-header-mark) {
			height: 26px;
		}
	}

	/*
	  The three words. Hidden below lg and shown in the panel instead — at 1024px
	  the bar has room for a wordmark, three nouns and a pill, and below it the
	  three nouns are the first thing that has to give.
	*/
	.ww-header-nav {
		display: none;
	}

	.ww-header-nav ul {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.ww-header-nav a {
		font-family: var(--font-sans);
		font-size: var(--text-body);
		font-weight: 500;
		color: var(--ww-ink);
		text-decoration: none;
		/* The underline is drawn on hover rather than being present and
		   transparent, so nothing shifts and there is no ghost line under a link
		   at rest. */
		text-decoration-color: transparent;
		text-underline-offset: 6px;
		transition: color var(--dur-fast) var(--ease-out);
	}

	.ww-header-nav a:hover {
		color: var(--ww-blue);
	}

	@media (min-width: 1024px) {
		.ww-header-nav {
			display: block;
		}
	}

	/* margin-inline-start: auto rather than justify-content on the row: it pins
	   the actions right regardless of whether the nav in the middle is rendered
	   at this width. */
	.ww-header-actions {
		margin-inline-start: auto;
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	/* Shorter and tighter than a page CTA. The bar is 64px tall; a 48px pill in
	   it would leave 8px of air above and below and read as a button wedged
	   into a header rather than part of one. */
	.ww-header-cta {
		min-height: 40px;
		padding-inline: 20px;
		font-size: var(--text-small);
	}

	@media (min-width: 768px) {
		.ww-header-cta {
			min-height: 44px;
			padding-inline: 24px;
			font-size: var(--text-body);
		}
	}

	/*
	  Two bars, not three. At this weight a third adds nothing but noise, and the
	  pair reads as a menu just as plainly.

	  44px square, which is the tap target; the bars inside it are 20px wide and
	  the padding around them is the rest.
	*/
	.ww-header-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		/* Pull the target's own padding back so the bars line up with the page
		   gutter rather than sitting a few pixels inside it. */
		margin-inline-end: -10px;
		background: none;
		border: 0;
		border-radius: var(--radius-pill);
		color: var(--ww-ink);
		cursor: pointer;
	}

	@media (min-width: 1024px) {
		.ww-header-toggle {
			display: none;
		}
	}

	.ww-header-bars {
		display: block;
		width: 20px;
	}

	.ww-header-bars span {
		display: block;
		height: 2px;
		background-color: currentColor;
		transition:
			transform var(--dur-base) var(--ease-out),
			opacity var(--dur-fast) var(--ease-out);
	}

	.ww-header-bars span + span {
		margin-top: 5px;
	}

	/* Open: the two bars cross. Each moves half the gap plus half its own height
	   to meet in the middle, then rotates. */
	[aria-expanded='true'] .ww-header-bars span:first-child {
		transform: translateY(3.5px) rotate(45deg);
	}

	[aria-expanded='true'] .ww-header-bars span:last-child {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	/*
	  The panel.

	  It animates on grid-template-rows rather than on height, which is what lets
	  it open to the height of its own content without that height being written
	  down anywhere. The child needs `min-height: 0` and `overflow: hidden` for
	  the row to be allowed to collapse below its content size.
	*/
	.ww-header-panel {
		display: grid;
		grid-template-rows: 0fr;
		background-color: var(--ww-white);
		border-top: 1px solid var(--ww-hairline-light);
		/* Closed, the panel is a 1px hairline sitting under a 1px hairline. Hide
		   its own edge until it has something to edge. */
		border-top-color: transparent;
		transition:
			grid-template-rows var(--dur-base) var(--ease-out),
			border-top-color var(--dur-base) var(--ease-out);
	}

	.ww-header-panel > nav {
		min-height: 0;
		overflow: hidden;
	}

	.ww-header-panel[data-open] {
		grid-template-rows: 1fr;
		border-top-color: var(--ww-hairline-light);
	}

	.ww-header-panel ul {
		margin: 0;
		padding: var(--space-md) var(--gutter) var(--space-lg);
		list-style: none;
	}

	/* Hairline-separated rows, the same device the pricing plans and the service
	   accordion are built from. */
	.ww-header-panel li + li {
		border-top: 1px solid var(--ww-hairline-light);
	}

	.ww-header-panel a {
		display: block;
		padding-block: var(--space-md);
		font-family: var(--font-sans);
		font-size: var(--text-heading);
		font-weight: 500;
		color: var(--ww-ink);
		text-decoration: none;
	}

	@media (min-width: 1024px) {
		.ww-header-panel {
			display: none;
		}
	}

	/* The panel's transition is the one piece of motion in the header, and under
	   this query it simply is not one: it opens and closes on the same frame.
	   The global collapse in base.css already does this; saying it here too
	   means the rule survives that file being reorganised. */
	@media (prefers-reduced-motion: reduce) {
		.ww-header-panel,
		.ww-header-bars span {
			transition: none;
		}
	}
</style>

<script>
	/*
	  The mobile menu. Roughly twenty lines, and it does four things: flips
	  aria-expanded, opens the panel, makes the panel reachable, and closes on
	  Escape or on a link being followed.
	  
	  It deliberately does NOT lock the page behind it. The panel hangs off the
	  header and is at most four rows tall; it does not cover the page, so there
	  is nothing to lock. `html[data-menu-open]` still exists in base.css for a
	  future full-screen panel, and is not set here.
	*/
	const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const panel = document.getElementById('site-menu');

	if (toggle && panel) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			panel.toggleAttribute('data-open', open);
			// `inert` is what actually removes the closed panel from the tab order
			// and from the accessibility tree. Without it the links inside a
			// zero-height panel are still focusable, and tabbing through the header
			// walks into a menu nobody can see.
			panel.toggleAttribute('inert', !open);
		};

		toggle.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		// Following a link inside the panel navigates to a fragment on this page,
		// which does not reload it — so nothing would close the menu.
		panel.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setOpen(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			if (toggle.getAttribute('aria-expanded') !== 'true') return;
			setOpen(false);
			// Send focus back to the control that opened it, or it is left on the
			// <body> and the next Tab starts from the top of the document.
			toggle.focus();
		});
	}

	/*
	  THE OVERLAY'S SURFACE, on scroll.

	  An IntersectionObserver rather than a scroll handler: there is no listener
	  on the scroll thread, nothing recalculating on every frame while the hero
	  video is playing, and the browser does the geometry itself.

	  WHAT IS OBSERVED is the first block inside <main>. On an overlay page that
	  is the full-bleed hero by definition — the overlay is not offered to a page
	  that opens on anything else — and the header stays ignorant of what the
	  hero component is called.

	  THE ROOT is shrunk from the top by the bar's own height, so the flip
	  happens at the moment the bottom of the hero passes under the bottom of the
	  bar rather than the top of the viewport. The height changes once, at the
	  768px breakpoint, so the observer is rebuilt whenever the bar resizes.
	*/
	const overlayHeader = document.querySelector<HTMLElement>('.ww-header[data-overlay]');
	const hero = document.querySelector('main')?.firstElementChild;

	if (overlayHeader && hero) {
		let observer: IntersectionObserver | undefined;

		const observe = () => {
			observer?.disconnect();
			observer = new IntersectionObserver(
				([entry]) => overlayHeader.toggleAttribute('data-solid', !entry.isIntersecting),
				{ rootMargin: `-${overlayHeader.offsetHeight}px 0px 0px 0px` },
			);
			observer.observe(hero);
		};

		observe();

		// Fires on the breakpoint that changes --header-h, and on nothing else:
		// the bar is a fixed height at any given width. Cheaper and more precise
		// than listening for every resize.
		new ResizeObserver(observe).observe(overlayHeader);
	}
</script>
