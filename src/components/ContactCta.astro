---
/**
 * Closing panel for the discipline pages. Forest rather than charcoal so it
 * reads as its own band instead of merging into the charcoal footer directly
 * beneath it — which is also why the button uses the inverted fill.
 */
import { CONTACT_HREF } from '../config/site';

interface Props {
	heading: string;
	body: string;
	class?: string;
}

const { heading, body, class: className = '' }: Props = Astro.props;
---

<section class:list={['bg-forest text-cream', className]} aria-labelledby="cta-heading">
	<div class="wrapper py-20 lg:py-28">
		<div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-16">
			<div class="lg:col-span-7">
				<h2 id="cta-heading" class="text-3xl leading-tight sm:text-4xl">{heading}</h2>
				<p class="mt-6 max-w-xl text-cream/80">{body}</p>
			</div>

			<div class="lg:col-span-5 lg:flex lg:justify-end">
				<a href={CONTACT_HREF} class="btn btn-cream">Get in touch</a>
			</div>
		</div>
	</div>
</section>
