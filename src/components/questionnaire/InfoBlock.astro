---
/**
 * An `info` question: prose in the middle of the form, answering nothing.
 *
 * It exists so a questionnaire can explain something — what we already have on
 * file, why a section is short, what a client does not need to prepare — at the
 * point it becomes relevant, rather than in an introduction nobody rereads.
 *
 * Set apart from the questions around it by a rule down its left edge and a
 * wash too faint to read as a status — see the style block below.
 */
import type { OfType } from '../../lib/questionnaire/schema';
import { DATA, questionId, showIfAttr } from '../../lib/questionnaire/dom';

interface Props {
	question: OfType<'info'>;
	isHidden: boolean;
}

const { question, isHidden }: Props = Astro.props;

const attrs = {
	[DATA.question]: question.id,
	[DATA.type]: 'info',
	...(question.showIf ? { [DATA.showIf]: showIfAttr(question.showIf) } : {}),
};
---

<div id={questionId(question.id)} class="q-question ww-info" hidden={isHidden} {...attrs}>
	{question.heading && <p class="ww-eyebrow ww-muted">{question.heading}</p>}

	<div class:list={['ww-info-body', question.heading && 'has-heading']}>
		{question.body.map((paragraph) => <p class="ww-body ww-muted">{paragraph}</p>)}
	</div>
</div>

<style>
	/* Set apart by a rule down its left edge and a wash too faint to read as a
	   status — the page's lightest ground, which is the same one a disabled
	   field takes. Deliberately not a card and not one of the state colours:
	   this is the page talking, not the page reporting something. */
	.ww-info {
		padding: var(--space-md);
		border-left: 2px solid var(--ww-hairline);
		background-color: var(--ww-light);
	}

	.ww-info-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
		max-width: 68ch;
	}

	.ww-info-body.has-heading {
		margin-top: var(--space-sm);
	}
</style>
