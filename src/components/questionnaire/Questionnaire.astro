---
/**
 * One questionnaire, rendered from its definition and nothing else.
 *
 * There is no Avioric component and there will not be one. Everything on the
 * page — the sections, their order, every question, every prefilled value,
 * which questions start hidden — comes out of the YAML file. A new client is a
 * new file.
 *
 * The bands are the portal's: a 2px charcoal rule opens each section, the title
 * sits under it in the display face, and the whole thing runs in the 64rem
 * portal shell. That is deliberate rather than convenient — a client who has
 * seen their project page should recognise this as the same room, and a form
 * dressed as a dashboard would say the opposite of what a questionnaire from a
 * studio is meant to say.
 *
 * The document is complete in the HTML: every question, every prefilled value
 * and every label is here before a line of script runs, and conditional
 * questions start in the state the definition's defaults imply rather than
 * being revealed by JavaScript.
 *
 * Submitting does need the script, and the button says so by being rendered
 * disabled and switched on from questionnaire.client.ts once its handlers are
 * attached — the ProjectStack pattern. Autosave and conditional visibility
 * already require JavaScript, so a button that posted without it would be
 * offering a worse form rather than a more resilient one; better to hold the
 * control than to take twenty answers and lose them.
 */
import type { Questionnaire as QuestionnaireDefinition } from '../../lib/questionnaire/schema';
import { eachQuestion, isAnswerable } from '../../lib/questionnaire/schema';
import { computeVisibility } from '../../lib/questionnaire/visibility';
import { DATA } from '../../lib/questionnaire/dom';
import {
	HONEYPOT_FIELD,
	SUBMIT_ENDPOINT,
	TURNSTILE_ACTION,
	submissionsEnabled,
} from '../../lib/questionnaire/config';
import { resolveTurnstileSiteKey } from '../../lib/questionnaire/turnstile';
import ConfirmDialog from './ConfirmDialog.astro';
import ErrorSummary from './ErrorSummary.astro';
import InfoBlock from './InfoBlock.astro';
import QuestionField from './QuestionField.astro';
import RestoreNotice from './RestoreNotice.astro';

interface Props {
	questionnaire: QuestionnaireDefinition;
}

const { questionnaire }: Props = Astro.props;

/*
 * First paint reflects the defaults, not an empty form. A question whose
 * condition is already satisfied by a prefilled answer is visible immediately,
 * so the page does not visibly rearrange itself the moment the script runs.
 */
const defaults: Record<string, unknown> = {};
for (const { question } of eachQuestion(questionnaire)) {
	if (isAnswerable(question) && 'default' in question && question.default !== undefined) {
		defaults[question.id] = question.default;
	}
}
const visible = computeVisibility(questionnaire, defaults);

const sectionCount = questionnaire.sections.length;
const turnstileSiteKey = resolveTurnstileSiteKey({
	configuredSiteKey: import.meta.env.PUBLIC_TURNSTILE_SITE_KEY,
	production: import.meta.env.PROD,
});
const turnstileConfigured = turnstileSiteKey.length > 0;
const submissionAvailable = submissionsEnabled && turnstileConfigured;

/*
 * Said on the console rather than on the page, and for the same reason the
 * homepage does it: an unwired endpoint is a launch checklist item, and a note
 * about one printed under a form is a message to us being shown to a client.
 */
if (!submissionsEnabled) {
	console.warn(
		`[wellworn] No SUBMIT_ENDPOINT set — the ${questionnaire.id} questionnaire's submit button is disabled.`,
	);
}

---

<form
	method="post"
	action={submissionsEnabled ? SUBMIT_ENDPOINT : undefined}
	{...{ [DATA.form]: '' }}
	{...{ [DATA.id]: questionnaire.id }}
	{...{ [DATA.version]: String(questionnaire.version) }}
	{...{ [DATA.token]: questionnaire.token }}
	{...{ [DATA.schemaVersion]: String(questionnaire.schemaVersion) }}
	{...{ [DATA.turnstileConfigured]: String(turnstileConfigured) }}
>
	{/* Both start hidden. The script unhides whichever the situation calls for:
	    the notice when a draft came back, the summary when a submission failed. */}
	<RestoreNotice />
	<ErrorSummary />

	{
		questionnaire.sections.map((section, index) => (
			<section
				class:list={['pb-2', index > 0 && 'mt-14 sm:mt-16']}
				aria-labelledby={`section-${section.id}`}
			>
				<span class="portal-rule" aria-hidden="true" />

				<div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 pt-6">
					<h2 id={`section-${section.id}`} class="display text-[1.25rem] leading-[1.15]">
						{section.title}
					</h2>

					{/* Real information rather than decoration: on a form this long,
					    knowing there are two sections left is the difference between
					    finishing and closing the tab. */}
					<p class="eyebrow text-charcoal/55">
						Section {index + 1} of {sectionCount}
					</p>
				</div>

				{section.description && (
					<p class="mt-3 max-w-[62ch] text-[1.0625rem] leading-relaxed text-charcoal/70">
						{section.description}
					</p>
				)}

				<div class="mt-8 flex flex-col gap-9">
					{section.questions.map((question) =>
						question.type === 'info' ? (
							<InfoBlock question={question} isHidden={!visible.has(question.id)} />
						) : (
							<QuestionField question={question} isHidden={!visible.has(question.id)} />
						),
					)}
				</div>
			</section>
		))
	}

	{/*
	  The close. One rule, one button, and a line saying what happens next —
	  which is the question every client has at the bottom of a long form and
	  the one thing a bare submit button never answers.
	*/}
	<div class="mt-14 border-t-2 border-charcoal pt-7 sm:mt-16">
		<div
			id="questionnaire-submit-status"
			role="alert"
			tabindex="-1"
			hidden
			class="mb-6 max-w-[42rem] scroll-mt-8 border-l-2 border-state-blocked bg-state-blocked/[0.04] py-4 pr-5 pl-5 text-[0.9375rem] leading-relaxed font-semibold text-state-blocked-deep"
		/>

		<div class="flex flex-wrap items-center gap-x-8 gap-y-5">
			<button
				type="submit"
				disabled={!submissionAvailable}
				class="btn btn-primary w-full sm:w-auto disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:border-charcoal disabled:hover:bg-charcoal"
			>
				{questionnaire.submitLabel}
			</button>

			<p class="max-w-[42ch] text-[0.9375rem] leading-relaxed text-charcoal/60">
				Your answers save on this device as you go, so you can close the page and come
				back to it.
			</p>

			<div
				class="basis-full"
				role="group"
				aria-label="Security verification by Cloudflare"
				data-turnstile-widget
			>
				<div
					class="cf-turnstile"
					data-sitekey={turnstileSiteKey}
					data-action={TURNSTILE_ACTION}
					data-theme="light"
					data-appearance="interaction-only"
				/>
			</div>
		</div>
	</div>

	{/* Honeypot. Bots fill it, people never see it. Same field name as the
	    contact form, so both forms are filtered the same way. */}
	<div class="hidden" aria-hidden="true">
		<label>
			Leave this field empty
			<input type="text" name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
		</label>
	</div>
</form>

<section
	id="questionnaire-success"
	tabindex="-1"
	hidden
	class="scroll-mt-8 border-t-2 border-charcoal pt-7"
>
	<p class="eyebrow text-state-current">Sent to Wellworn</p>
	<h2 class="display mt-4 text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)] leading-tight">
		Questionnaire received.
	</h2>
	<div class="mt-5 flex max-w-[62ch] flex-col gap-4 text-[1.0625rem] leading-relaxed text-charcoal/75">
		{questionnaire.confirmation.map((paragraph) => <p>{paragraph}</p>)}
	</div>
</section>

{/*
  Start fresh asks before it clears, and this is where it asks. Outside the
  form rather than beside the button that opens it, because the dialog holds a
  form of its own and the parser discards a nested one — see ConfirmDialog.

  Rendered whether or not a draft came back. The button that opens it lives in
  the restore notice, which is hidden until there is something to restore, so
  an unreachable dialog costs a few hundred bytes and a conditional costs a
  reason to think about ordering.
*/}
<ConfirmDialog
	id="questionnaire-start-fresh"
	heading="Start fresh?"
	body="This will clear the answers saved on this device and restart the questionnaire."
	confirmLabel="Clear answers"
/>

<script>
	import './questionnaire.client';
</script>

<script
	is:inline
	src="https://challenges.cloudflare.com/turnstile/v0/api.js"
	async
	defer
/>
