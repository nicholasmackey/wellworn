---
/**
 * One row of "Your next steps" — a thing the client has to do.
 *
 * Never written by hand. The list is assembled from the steps of the live
 * phase, so an item exists here because a step in the project data is
 * unfinished and marked `clientAction`, and it stops existing the moment that
 * step is marked complete.
 *
 * The button is the part worth being careful about: it renders only when the
 * step actually has somewhere to send her. Until a signing link or a payment
 * link exists, the item is the task and its status and nothing else — a button
 * that goes nowhere, or worse a plausible one that 404s, undoes exactly the
 * impression this page is for. When there is one it is the site's own filled
 * action, at the site's own size, because there is no such thing as a portal
 * button.
 */
import type { PhaseStep } from '../../config/project';
import StateChip from './StateChip.astro';

interface Props {
	step: PhaseStep;
}

const { step }: Props = Astro.props;

/* The instruction if the step carries one, the task's own name otherwise. */
const label = step.actionLabel ?? step.label;

/* A task becomes a link only when the project data supplies the destination
   and its label. A partial CTA is omitted instead of being completed here. */
const cta = step.url && step.ctaLabel ? { href: step.url, label: step.ctaLabel } : null;

/* Red only where the data actually says so. A step that is merely waiting is
   amber; a step that has failed or gone overdue is the one that earns red. */
const actionState =
	step.status === 'overdue'
		? { label: 'Overdue', variant: 'blocked' as const }
		: step.status === 'blocked'
			? { label: 'Blocked', variant: 'blocked' as const }
			: { label: 'Action needed', variant: 'action' as const };
---

{/*
  Mobile gives the task, state, and optional CTA their own clean rows. From the
  small breakpoint up, the state returns inline and the CTA sits to the right.

  No marker in the left margin. ACTION NEEDED follows the task in amber, and the
  label starts hard against the column's own left edge with the rest of the
  page's type.
*/}
<li class="ww-action">
	<div class="ww-action-task">
		<p class="ww-body-lg">
			{label}
			<span class="ww-action-state">
				<StateChip label={actionState.label} variant={actionState.variant} />
			</span>
		</p>

		{step.detail && <p class="ww-body ww-muted ww-action-detail">{step.detail}</p>}
	</div>

	{
		cta && (
			<a
				href={cta.href}
				target="_blank"
				rel="noopener noreferrer"
				class="ww-btn ww-btn-dark ww-action-cta"
			>
				{cta.label}
				<svg
					viewBox="0 0 12 12"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="square"
					class="ww-action-arrow"
					aria-hidden="true"
				>
					<path d="M2.5 6h7M6.5 3l3 3-3 3" />
				</svg>
			</a>
		)
	}
</li>

<style>
	.ww-action {
		padding-block: var(--space-md);
		border-top: 1px solid var(--ww-hairline);
	}

	.ww-action-task {
		min-width: 0;
		flex: 1;
	}

	/* Its own line on a phone, where "Action needed" after a long task would
	   otherwise be pushed off the end of it. */
	.ww-action-state {
		display: block;
		margin-top: var(--space-sm);
	}

	.ww-action-detail {
		margin-top: var(--space-xs);
	}

	.ww-action-cta {
		display: flex;
		width: 100%;
		margin-top: var(--space-md);
	}

	.ww-action-arrow {
		width: 12px;
		height: 12px;
	}

	@media (min-width: 640px) {
		.ww-action {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--space-sm) var(--space-md);
		}

		.ww-action-state {
			display: inline;
			margin-top: 0;
			margin-left: var(--space-sm);
		}

		.ww-action-cta {
			display: inline-flex;
			width: auto;
			margin-top: 0;
		}
	}
</style>
