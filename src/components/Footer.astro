---
import { BRAND, NAV, SERVICES, SITE } from '../config/site';

interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;

const year = new Date().getFullYear();
---

<footer class:list={['bg-charcoal text-cream', className]}>
	<div class="wrapper py-16 lg:py-24">
		<div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<div class="lg:col-span-2">
				<a href="/" class="inline-block transition-opacity duration-200 hover:opacity-70">
					<img
						src={BRAND.wordmarkLight}
						alt={SITE.name}
						width={149}
						height={36}
						loading="lazy"
						decoding="async"
						class="h-8 w-auto sm:h-9"
					/>
				</a>
				<p class="mt-6 max-w-sm text-stone">
					Web design and development, brand identity, and photography.
				</p>
			</div>

			<div>
				<h2 class="eyebrow text-stone">Services</h2>
				<ul class="mt-6 space-y-3">
					{
						SERVICES.map((service) => (
							<li>
								<a
									href="/#services"
									class="text-cream/90 transition-colors duration-200 hover:text-cream"
								>
									{service.title}
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div>
				<h2 class="eyebrow text-stone">Navigate</h2>
				<ul class="mt-6 space-y-3">
					{
						NAV.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-cream/90 transition-colors duration-200 hover:text-cream"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>

				<h2 class="eyebrow mt-10 text-stone">Contact</h2>
				<p class="mt-6">
					<a
						href={`mailto:${SITE.email}`}
						class="text-cream underline decoration-stone/60 underline-offset-4 transition-colors duration-200 hover:decoration-cream"
					>
						{SITE.email}
					</a>
				</p>
			</div>
		</div>

		<div
			class="mt-16 flex flex-col gap-2 border-t border-cream/15 pt-8 sm:flex-row sm:items-center sm:justify-between"
		>
			{/* Kept on one line: a newline between two expressions is stripped as
			    JSX-style whitespace, which would run the year into the name. */}
			<p class="eyebrow text-stone">&copy; {year} {SITE.name}</p>
			<p class="eyebrow text-stone">All rights reserved</p>
		</div>
	</div>
</footer>
