---
import { BRAND, NAV, SITE } from '../config/site';

interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;

const year = new Date().getFullYear();
---

<footer class:list={['bg-charcoal text-cream', className]}>
	<div class="wrapper py-16 lg:py-24">
		<div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<div class="sm:col-span-2">
				<a href="/" class="inline-block transition-opacity duration-200 hover:opacity-70">
					<img
						src={BRAND.wordmarkLight}
						alt={SITE.name}
						width={149}
						height={36}
						loading="lazy"
						decoding="async"
						class="h-8 w-auto sm:h-9"
					/>
				</a>
				<p class="mt-6 max-w-sm text-stone">Design, development, and photography.</p>
			</div>

			{/* The same two destinations as the header, without the services
			    beneath them: those are the discipline pages' job to explain. */}
			<nav aria-label="Footer">
				<ul class="space-y-3">
					{
						NAV.map((item) => (
							<li>
								<a
									href={item.href}
									class="text-cream/90 transition-colors duration-200 hover:text-cream"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			{/*
			  The target every "Get in touch" CTA scrolls to. Anchor offset comes
			  from `scroll-padding-top` in global.css, so the sticky header never
			  covers the heading.
			*/}
			<section id="contact" aria-labelledby="contact-heading">
				<h2 id="contact-heading" class="eyebrow text-stone">Have a project?</h2>
				<p class="mt-6">
					<a
						href={`mailto:${SITE.email}`}
						class="text-cream underline decoration-stone/60 underline-offset-4 transition-colors duration-200 hover:decoration-cream"
					>
						{SITE.email}
					</a>
				</p>
			</section>
		</div>

		<div class="mt-16 border-t border-cream/15 pt-8">
			{/* Kept on one line: a newline between two expressions is stripped as
			    JSX-style whitespace, which would run the year into the name. */}
			<p class="eyebrow text-stone">&copy; {year} {SITE.name}</p>
		</div>
	</div>
</footer>
