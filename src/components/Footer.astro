---
import { BRAND, SITE } from '../config/site';

interface Props {
	class?: string;
}

const { class: className = '' }: Props = Astro.props;

const year = new Date().getFullYear();
---

{/*
  The rust rule is what separates the footer from the contact panel above it,
  which is charcoal now too. One hairline does the job the old forest band
  was doing, and it is the same accent that opens the sections upstairs.
*/}
<footer class:list={['border-t border-stone/40 bg-charcoal text-cream', className]}>
	<div class="wrapper py-16 lg:py-24">
		<div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
			<div class="sm:col-span-2">
				<a href="/" class="inline-block transition-opacity duration-200 hover:opacity-70">
					<img
						src={BRAND.wordmarkLight}
						alt={SITE.name}
						width={149}
						height={36}
						loading="lazy"
						decoding="async"
						class="h-8 w-auto sm:h-9"
					/>
				</a>
				<p class="mt-6 max-w-sm text-stone">Web design and development.</p>
			</div>

			{/*
			  Not the #contact target any more: that is the homepage form, which
			  every CTA now scrolls to. This is the plain email address, for
			  anyone who would rather not use a form.
			*/}
			<section aria-labelledby="footer-contact-heading" class="lg:col-start-4">
				<h2 id="footer-contact-heading" class="eyebrow text-stone">Have a project?</h2>
				<p class="mt-6">
					<a
						href={`mailto:${SITE.email}`}
						class="text-cream underline decoration-stone/60 underline-offset-4 transition-colors duration-200 hover:decoration-rust"
					>
						{SITE.email}
					</a>
				</p>
			</section>
		</div>

		<div class="mt-16 border-t border-cream/15 pt-8">
			{/* Kept on one line: a newline between two expressions is stripped as
			    JSX-style whitespace, which would run the year into the name. */}
			<p class="eyebrow text-stone">&copy; {year} {SITE.name}</p>
		</div>
	</div>
</footer>
