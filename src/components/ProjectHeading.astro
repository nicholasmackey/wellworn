---
import type { Project } from '../config/site'

interface Props {
	project: Project
}

const { project } = Astro.props

/* Middots rather than commas: the services are a list of separate pieces of
   work, not a sentence, and the separator is a presentation decision — which is
   why it lives here and not in the copy.

   The space before the middot is non-breaking and the one after it is not, so
   the separator is glued to the item it follows. Four disciplines will not fit
   on one line in a five-column well, and the break has to land between two
   disciplines: bound this way a wrapped line can never open with a dangling
   dot, which is the one break that reads like a typo rather than a list. */
const services = project.services.join('\u00A0· ')
---

{/*
  The furniture every project shares, so the three read as one list however
  differently their pictures are arranged underneath. There are no numbers on
  it: three items do not need counting, and a run of large rust ordinals down
  the section made the projects look like a numbered stack — which is the one
  thing the compositions below are working not to be.

  The rule is charcoal rather than rust. Rust opens the whole section, and
  three more of it here would flatten that distinction into a pattern.

  Two registers, stacked. The name and the live link share a left edge, the
  link sitting directly under the name it belongs to as a caption to it rather
  than as a masthead split across the full measure. Parted to opposite ends
  they read as one line at 1280px and as two unrelated fragments everywhere
  narrower, where the gap between them closes and the link ends up beside a
  name it has no visible tie to. Under them the case is made: the headline at
  lede scale on the left, the
  context and the work done on the right. That split is what turns a portfolio
  label into a preview. It is also why the headline is a <p> and the name is
  the heading: the name is what this piece of work is called, and the headline
  is a claim about it, which is a different job.

  Sentence case and Source Sans for the headline, deliberately. Everything at
  this scale on the page is uppercase Russo, and an eighty-character sentence
  set that way is a wall. The change of voice is what makes it read as
  something being said rather than something being labelled.

  Only the domain is a link: the name repeated as a second anchor to the same
  page would be one more tab stop that says nothing new, and the URL is the
  part that tells you where you are about to go.
*/}
<div class="border-t border-charcoal/40 pt-5">
	<div>
		<h3 class="display display-item">{project.title}</h3>

		{/* Label voice rather than body voice: the same small uppercase register
		    as the services line below, though a step larger than it and marked as
		    a link by its underline and by taking full-strength charcoal where the
		    services are muted.

		    11px, between the eyebrow's 12 and the services line's 10. Under a name
		    set at up to 40px it only has to be legible, not loud — the underline
		    and the arrow are what mark it as somewhere to go, and at label size
		    they do that without it matching the eyebrows elsewhere on the page.

		    inline-flex, so the box is the width of the text: a block-level anchor
		    would stretch the underline and the hover target the full column. */}
		<a
			href={project.href}
			rel="noopener"
			class="eyebrow mt-3 inline-flex items-center gap-2 text-[0.6875rem] text-charcoal underline decoration-charcoal/25 underline-offset-[6px] transition-colors duration-200 hover:text-rust hover:decoration-rust"
		>
			{project.label}
			<svg
				aria-hidden="true"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="square"
				class="h-2.5 w-2.5 shrink-0"
			>
				<path d="M7 17 17 7M8 7h9v9"></path>
			</svg>
		</a>
	</div>

	{/* Seven columns and five, sharing one gutter. The headline gets the wider
	    half because it is the thing being said; the supporting column is capped
	    at the measure a five-column block gives it anyway. */}
	<div class="mt-8 grid gap-y-5 lg:mt-10 lg:grid-cols-12 lg:gap-x-12">
		<p
			class="text-[1.375rem] leading-[1.2] text-balance sm:text-[1.625rem] lg:col-span-7 lg:text-[2rem]"
		>
			{project.headline}
		</p>

		<div class="lg:col-span-5">
			<p class="max-w-xl leading-relaxed text-charcoal/70 sm:text-lg">{project.summary}</p>

			{/* Two steps under the eyebrow's 12px, which is as small as this can go:
			    the line is the smallest claim on the card — what the work was, not
			    what it says — and at label size it competed with the summary above it
			    for the same attention. 0.14em of tracking is what holds 10px uppercase
			    together; below this the tracking stops rescuing it.

			    Balanced rather than left to fill: four disciplines overrun the well
			    at any size that stays readable, so the choice is which two lines, not
			    whether to wrap. Balance splits them evenly instead of stranding one
			    discipline alone under a full line.

			    /70, not /60: small type needs the full 4.5:1, and charcoal at 60%
			    lands at 4.1:1 on cream. */}
			<p class="eyebrow mt-5 text-[0.625rem] leading-[1.8] text-balance text-charcoal/70">
				{services}
			</p>
		</div>
	</div>
</div>
