---
import { Image } from 'astro:assets'
import type { Shot } from '../config/site'

interface Props {
	shot: Shot
	/** The live site. Every screenshot is a way into the work it shows. */
	href: string
	/** Rendered width of this shot at each breakpoint, for srcset selection. */
	sizes: string
	/** Grid placement and any width cap. Applied to the link, which is the box. */
	class?: string
	loading?: 'eager' | 'lazy'
}

const { shot, href, sizes, class: className, loading = 'lazy' } = Astro.props

/**
 * Never ask for a candidate wider than the source. sharp will upscale on
 * request, which costs bytes and adds no detail — and the sources are not all
 * the same size: the desktop captures are 1792px wide, the phone one is 463.
 * Filter the ladder against the file, then pin its native width on the end so
 * the largest candidate is always the sharpest one available.
 */
const widths = [
	...[400, 640, 960, 1280, 1600].filter((width) => width < shot.src.width),
	shot.src.width,
]
---

{/*
  A screenshot is not a photograph: several of these are pages on a near-white
  or (in Davis's case) an almost exactly cream ground, and laid straight onto
  this page they would dissolve into it with no edge at all. The hairline is
  what gives them one. It is the same rule weight the rest of the page is drawn
  with rather than a frame around the picture — no chrome, no device, no shadow,
  no padded card.

  The faint ground underneath shows through only while the file is still
  arriving; Image reserves the height from the file's real dimensions, so
  nothing below moves when it lands.
*/}
<a
	href={href}
	rel="noopener"
	class:list={[
		'group/shot block overflow-hidden rounded-sm border border-charcoal/10 bg-stone/15',
		className,
	]}
>
	<Image
		src={shot.src}
		alt={shot.alt}
		widths={widths}
		sizes={sizes}
		quality={80}
		loading={loading}
		decoding="async"
		class="w-full transition-transform duration-700 ease-out motion-safe:group-hover/shot:scale-[1.02]"
	/>
</a>
