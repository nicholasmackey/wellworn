---
/**
 * YOUR WEBSITE SHOULD EARN ITS KEEP.
 *
 * Back to a light ground after two black sections, and written as a statement
 * rather than as a pitch. One photograph of people actually running something,
 * deliberately not a screenshot of a website: the section argues that a website
 * is worth what it does for a business, and illustrating that with a picture of
 * a website would be the exact opposite point.
 *
 * The composition is the inverse of the promise bands upstairs — picture first
 * and wide, copy underneath at container width — so the page does not arrive at
 * its philosophy statement in the same shape it made its three feature claims.
 */
import { Image } from 'astro:assets';
import { PHILOSOPHY } from '../../config/home';

interface Props {
	id?: string;
}

const { id }: Props = Astro.props;
---

<section class="ww-section ww-philosophy" id={id} aria-labelledby="philosophy-heading">
	<div class="ww-container">
		<div class="ww-philosophy-grid">
			<div class="ww-philosophy-copy">
				<h2 id="philosophy-heading" class="ww-display-lg">{PHILOSOPHY.heading}</h2>

				<div class="ww-philosophy-body">
					{PHILOSOPHY.body.map((paragraph) => <p class="ww-body-lg ww-measure">{paragraph}</p>)}
				</div>
			</div>

			<div class="ww-media ww-media-card ww-philosophy-media">
				<Image
					src={PHILOSOPHY.image}
					alt={PHILOSOPHY.imageAlt}
					width={1600}
					widths={[640, 960, 1280, 1600]}
					sizes="(min-width: 1024px) 1200px, 100vw"
					quality={68}
					loading="lazy"
					decoding="async"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.ww-philosophy {
		background-color: var(--ww-white);
	}

	.ww-philosophy-body {
		margin-top: var(--space-md);
	}

	.ww-philosophy-body > * + * {
		margin-top: var(--space-md);
	}

	.ww-philosophy-media {
		margin-top: var(--space-xl);
		aspect-ratio: 4 / 3;
	}

	@media (min-width: 768px) {
		.ww-philosophy-media {
			margin-top: var(--space-2xl);
			/* Wide and cinematic. This is the one photograph on the page given the
			   full container rather than half of it. */
			aspect-ratio: 16 / 9;
		}
	}

	@media (min-width: 1024px) {
		/* The three short paragraphs sit beside the heading rather than under it,
		   which keeps the statement and its reasoning on one line of sight and
		   leaves the picture the full width beneath them. */
		.ww-philosophy-copy {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--space-3xl);
			align-items: start;
		}

		.ww-philosophy-body {
			margin-top: 0;
		}

		.ww-philosophy-media {
			aspect-ratio: 21 / 9;
		}
	}
</style>
