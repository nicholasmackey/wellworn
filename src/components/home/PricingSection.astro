---
/**
 * THE ONE WEBSITE OFFER.
 *
 * Black ground, one price, and the whole thing sized to sit inside a single
 * desktop screen. The left column belongs to the person behind the price; the
 * right column to the price and everything it buys.
 *
 * THE ORDER IT IS MEANT TO BE READ IN, and every size below is chosen to
 * enforce it: a better website → $0 down, $175 a month → what one payment
 * covers → six things it covers → the price again, attached to all of them →
 * start a project. The figure is the loudest thing in the section, two steps
 * above its own heading, because by the time someone reaches this section the
 * argument has been made and the number is the remaining question.
 *
 * THE INVENTORY is six rows on hairlines rather than six cards. A card would
 * turn each item into an object to be weighed on its own; the point of this
 * grid is its length, read in one pass, under one figure. Titles carry a
 * heavier weight and the section's white; descriptions drop a step in size
 * and to the dark-ground grey, so a scan reads six names before it reads a
 * word of explanation.
 *
 * THE PORTRAIT stretches to whatever height the copy beside it comes to, so
 * the two columns bottom out together without either being given a fixed
 * height. The identification card is a real <figcaption> sitting over the
 * lower part of the frame — the one white object in a black section, which is
 * the whole reason it draws the eye.
 *
 * ON A PHONE the picture follows the copy rather than leading it. Source order
 * is the mobile order; the desktop grid places the portrait back on the left.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTACT_HREF, CTA_LABEL } from '../../config/site';
import type { Point } from '../../config/site';
import WordReveal from '../WordReveal.astro';

interface Props {
	eyebrow: string;
	/** The heading, one entry a line. See PRICING in config/home. */
	heading: readonly string[];
	upfront: string;
	monthly: string;
	/** The lede, one entry a paragraph. */
	body: readonly string[];
	features: readonly Point[];
	closing: string;
	portrait: ImageMetadata;
	portraitAlt: string;
	ownerName: string;
	ownerRole: string;
	id?: string;
}

const {
	eyebrow,
	heading,
	upfront,
	monthly,
	body,
	features,
	closing,
	portrait,
	portraitAlt,
	ownerName,
	ownerRole,
	id,
}: Props = Astro.props;

/* Where each heading line's stagger picks up, so two lines arrive as one
   sentence rather than as two that each start over. Same device as the
   closing statement. */
const wordCounts = heading.map((line) => line.split(/\s+/).filter(Boolean).length);
const lineStarts = wordCounts.map((_, index) =>
	wordCounts.slice(0, index).reduce((total, count) => total + count, 0),
);
---

<section class="ww-section ww-section-dark ww-pricing" id={id} aria-labelledby="pricing-heading">
	<div class="ww-container">
		<div class="ww-pricing-grid">
			<div class="ww-pricing-offer" data-reveal-group>
				<p class="ww-eyebrow ww-muted">{eyebrow}</p>

				{/*
				  The space between the line spans is not cosmetic. Adjacent
				  elements with no whitespace between them are concatenated
				  without one when the accessible name is computed, and this
				  heading is the section's aria-labelledby target.
				*/}
				<h2 id="pricing-heading" class="ww-display-md ww-pricing-heading">
					{
						heading.map((line, index) => (
							<>
								<span data-word-reveal>
									<WordReveal text={line} start={lineStarts[index]} />
								</span>{' '}
							</>
						))
					}
				</h2>

				<p class="ww-pricing-price" data-reveal-block>
					<span>{upfront}</span>{' '}<span>{monthly}</span>
				</p>

				<div class="ww-pricing-body" data-reveal-block style="--wr-i:1">
					{body.map((paragraph) => <p class="ww-body ww-muted">{paragraph}</p>)}
				</div>

				<ul class="ww-pricing-benefits">
					{
						features.map((feature) => (
							<li>
								<h3 class="ww-body ww-pricing-benefit-title">{feature.title}</h3>
								<p class="ww-small ww-muted">{feature.body}</p>
							</li>
						))
					}
				</ul>

				<div class="ww-pricing-actions">
					<p class="ww-body-lg ww-pricing-close">{closing}</p>
					<a href={CONTACT_HREF} class="ww-btn ww-btn-blue">{CTA_LABEL}</a>
				</div>
			</div>

			<figure class="ww-pricing-portrait">
				<div class="ww-media ww-media-card ww-pricing-photo">
					<Image
						src={portrait}
						alt={portraitAlt}
						width={960}
						widths={[480, 720, 960]}
						sizes="(min-width: 1024px) 480px, 100vw"
						quality={72}
						loading="lazy"
						decoding="async"
					/>
				</div>

				<figcaption class="ww-pricing-id">
					<p class="ww-display-md ww-pricing-name">{ownerName}</p>
					<p class="ww-small ww-pricing-role">{ownerRole}</p>
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	/* One screen is the brief, so this section takes the 80px rhythm at every
	   width rather than the 120px the tablet-and-up default would give it. */
	.ww-pricing {
		padding-block: var(--space-2xl);
	}

	.ww-pricing-grid {
		display: grid;
		gap: var(--space-xl);
	}

	.ww-pricing-heading {
		margin-top: var(--space-sm);
		max-width: 22ch;
	}

	.ww-pricing-heading > span {
		display: block;
	}

	/* THE FIGURE. Two lines, set as blocks, and the loudest type in the
	   section by two steps — it is drawn a tier above the heading it sits
	   under, on the display face, at a line height tight enough that the two
	   lines read as one quantity rather than as two statements.

	   The size is written here rather than taken from .ww-display-xl because
	   the ceiling is set by this column: the figure has to fit the 6fr half of
	   a 1200px container without wrapping, and display-xl's 81px is past that.
	   The size on this rule is the FIRST line's; the second takes half of it
	   below. */
	.ww-pricing-price {
		margin-top: var(--space-md);
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(3rem, 1.5rem + 4.7vw, 4.5rem); /* 48 → 72 */
		line-height: 0.98;
		letter-spacing: var(--tracking-display);
	}

	.ww-pricing-price > span {
		display: block;
	}

	/* THE SECOND LINE, at half the first. "$0 down." is the thing that stops
	   someone, so it takes the whole size; the monthly figure answers it and
	   sits under it as the smaller of the pair. Written as an em so the two
	   stay in a 2:1 ratio at every width rather than needing a clamp of their
	   own, and given a little air because a 36px line tucked straight under a
	   72px one at 0.98 leading reads as crowded. */
	.ww-pricing-price > span + span {
		margin-top: var(--space-xs);
		font-size: 0.5em;
	}

	.ww-pricing-body {
		margin-top: var(--space-md);
		max-width: 56ch;
	}

	.ww-pricing-body p + p {
		margin-top: var(--space-sm);
	}

	/* THE INVENTORY. No cards. The grid is hairlines and space, which is the
	   only structural device this site has besides the change of ground. */
	.ww-pricing-benefits {
		display: grid;
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--ww-hairline-dark);
	}

	.ww-pricing-benefits li {
		padding-block: var(--space-sm);
	}

	.ww-pricing-benefits li + li {
		border-top: 1px solid var(--ww-hairline-dark);
	}

	/* A clear step above the description beside it: the section's white
	   against the dark-ground grey, 16px against 14px, 600 against 400. Six
	   titles should be readable as a list on their own. */
	.ww-pricing-benefit-title {
		font-weight: 600;
		letter-spacing: -0.005em;
	}

	.ww-pricing-benefits p {
		margin-top: 2px;
	}

	.ww-pricing-actions {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: var(--space-md);
		margin-top: var(--space-md);
		padding-top: var(--space-md);
		border-top: 1px solid var(--ww-hairline-dark);
	}

	/* The one piece of secondary copy in the section that is not muted. It is
	   the sentence the whole section is built to deliver, so it takes the
	   white and a medium weight and sits a size above the inventory. */
	.ww-pricing-close {
		max-width: 34ch;
		font-weight: 500;
	}

	/* THE PORTRAIT. Tall on a phone, and from the desktop breakpoint up it
	   simply fills whatever height the column beside it comes to. */
	.ww-pricing-portrait {
		position: relative;
		margin: 0;
	}

	.ww-pricing-photo {
		aspect-ratio: 4 / 5;
	}

	/* Tucked into the right edge of the frame, sitting high enough off the
	   bottom to clear the photograph's 50px radius. The corners that meet the
	   edge are squared so the card reads as running off it rather than
	   floating short of it. */
	.ww-pricing-id {
		position: absolute;
		right: 0;
		bottom: var(--space-lg);
		max-width: calc(100% - var(--space-md) * 2);
		padding: var(--space-sm) var(--space-md);
		border-radius: var(--radius-input) 0 0 var(--radius-input);
		background-color: var(--ww-white);
		color: var(--ww-ink);
	}

	/* The one line of display type that is a name rather than a statement, so
	   it takes the heading step rather than a display step. */
	.ww-pricing-name {
		font-size: var(--text-heading);
	}

	/* The one place on a dark section where the muted grey has to be the light
	   ground's value, because the card is white. */
	.ww-pricing-role {
		margin-top: 2px;
		color: var(--ww-muted);
	}

	@media (min-width: 640px) {
		/* Three rows of two. The row rule has to run the full width of the
		   grid, so it is drawn on the odd cells only and the even cell takes
		   the vertical rule instead — a border on every cell would double up
		   at the column gap. */
		.ww-pricing-benefits {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: var(--space-lg);
		}

		.ww-pricing-benefits li + li {
			border-top: 0;
		}

		.ww-pricing-benefits li:nth-child(n + 3) {
			border-top: 1px solid var(--ww-hairline-dark);
		}

		/* The only vertical rule in the grid, and it is the same hairline. */
		.ww-pricing-benefits li:nth-child(even) {
			padding-left: var(--space-lg);
			border-left: 1px solid var(--ww-hairline-dark);
		}

		.ww-pricing-actions {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-lg);
		}

		.ww-pricing-actions .ww-btn {
			flex: none;
		}
	}

	@media (min-width: 768px) {
		.ww-pricing-portrait {
			max-width: 520px;
		}
	}

	@media (min-width: 1024px) {
		/* Where the two columns appear, and the only width at which the whole
		   offer is meant to be taken in at once. The rhythm tightens again so
		   the eyebrow and the button land inside one screen. */
		.ww-pricing {
			padding-block: var(--space-xl);
		}

		.ww-pricing-grid {
			grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
			column-gap: var(--space-2xl);
			align-items: stretch;
		}

		/* Source order is the phone's order — copy, then picture. The desktop
		   composition puts the picture back on the left. */
		.ww-pricing-portrait {
			grid-column: 1;
			grid-row: 1;
			max-width: none;
			display: flex;
		}

		.ww-pricing-offer {
			grid-column: 2;
			grid-row: 1;
		}

		/* Fills the row, which the copy column sizes. The floor keeps the crop
		   from going letterbox if the copy ever gets shorter. */
		.ww-pricing-photo {
			aspect-ratio: auto;
			width: 100%;
			min-height: 560px;
		}
	}

	@media (min-width: 1280px) {
		.ww-pricing-grid {
			column-gap: var(--space-3xl);
		}
	}
</style>
