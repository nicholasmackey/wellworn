---
/**
 * GET FOUND — a local search, on a phone.
 *
 * Someone searches for a bakery near them, the business we care about climbs
 * from third to first, and its rating settles at five stars. Three beats, a
 * little over two seconds, once per page load. That is the whole argument and
 * nothing else in the frame competes with it.
 *
 * The handset comes from SmartphoneFrame, which is only a device: the search
 * interface below is slotted into its screen and clipped by it. The demo opens
 * at half size so the first thing read is "this is a phone", then pushes in to
 * full size where the screen — not the object — is what you are looking at.
 * The zoom is a transform on a device laid out at its FINAL size, so the state
 * that holds is untransformed and the type in it is rasterised sharp.
 *
 * THE CHROME IS GOOGLE'S. The mark, the search field, the result tabs and the
 * Places header are dressed to read as a search result page at a glance, so
 * nobody has to be told what they are looking at. Everything below the chrome
 * is ours: the businesses, the ratings and the ranking are all invented, and
 * nothing on this screen is a real listing or a real search.
 */
import SmartphoneFrame from '../../SmartphoneFrame.astro';

interface Props {
	/**
	 * Hold the sequence back for whoever placed the frame to start.
	 *
	 * The promise band leaves this off: scrolling the band into view is
	 * exactly when the search should run. The service rail sets it, because
	 * its copy of the frame sits inside a card that is closed until someone
	 * opens it, and a sequence that played on the way past would be over by
	 * then. See startLocalSearch in local-search.client.ts.
	 */
	defer?: boolean;
}

const { defer = false }: Props = Astro.props;

interface Result {
	readonly name: string;
	readonly rating: string;
	/** Out of five, as a percentage, for the clipped star row. */
	readonly fill: string;
	readonly reviews: string;
	readonly meta: string;
	readonly featured?: boolean;
}

/*
 * DOM order is the starting order. The business that moves is third in it,
 * and its 3.5 is what the sequence ends by fixing.
 */
const RESULTS: readonly Result[] = [
	{ name: 'Copper Kettle Bakery', rating: '4.6', fill: '92%', reviews: '96', meta: 'Bakery · Open · 1.1 mi' },
	{ name: 'Marlow Street Bread', rating: '4.4', fill: '88%', reviews: '61', meta: 'Bakery · Closed · 1.6 mi' },
	{
		name: 'Rise & Rye Bakehouse',
		rating: '3.5',
		fill: '70%',
		reviews: '38',
		meta: 'Bakery · Open · 0.4 mi',
		featured: true,
	},
	{ name: 'Twelve Grain Co.', rating: '4.1', fill: '82%', reviews: '44', meta: 'Bakery · Open · 2.3 mi' },
];

/* The result tabs, as a search page has them. The first one is the one the
   page is on, and none of them do anything. */
const TABS: readonly string[] = ['All', 'Maps', 'Images', 'News', 'Videos'];

/* The typed query. The client script swaps the tail for a coarse locality when
   one can be inferred from the browser's own time zone; it never asks for a
   location. This is what renders without JavaScript, and what a crawler sees. */
const QUERY = 'best bakery near me';
---

<div
	class="wws"
	data-local-search
	data-deferred={defer ? '' : undefined}
	data-query={QUERY}
	role="img"
	aria-label="A local search for “best bakery near me” on a phone. Four nearby bakeries are listed, and the featured one, Rise &amp; Rye Bakehouse, has risen to the first result with a five star rating."
>
	<SmartphoneFrame>
		<div class="wws-app">
			<div class="wws-searchbar">
				<img class="wws-mark" src="/images/brand/google-g.svg" alt="" aria-hidden="true" />
				<span class="wws-query"><span data-typed>{QUERY}</span><i class="wws-caret" aria-hidden="true"></i></span>

				<span class="wws-tools" aria-hidden="true">
					{/* The microphone and the lens, in the colours they are drawn in. */}
					<svg class="wws-tool" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path fill="#4285f4" d="M12 2.5a2.6 2.6 0 0 1 2.6 2.6v1.4H9.4V5.1A2.6 2.6 0 0 1 12 2.5Z"></path>
						<path fill="#ea4335" d="M9.4 6.5h5.2v2.6H9.4z"></path>
						<path fill="#fbbc04" d="M9.4 9.1h5.2v2.6H9.4z"></path>
						<path fill="#34a853" d="M9.4 11.7h5.2v.6a2.6 2.6 0 0 1-5.2 0v-.6Z"></path>
						<path
							fill="#5f6368"
							d="M6.2 11.2a.85.85 0 0 1 1.7 0 4.1 4.1 0 0 0 8.2 0 .85.85 0 0 1 1.7 0 5.8 5.8 0 0 1-4.95 5.72V19h-1.7v-2.08A5.8 5.8 0 0 1 6.2 11.2Z"
						></path>
					</svg>

					<svg class="wws-tool" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<g fill="none" stroke="#5f6368" stroke-width="1.9" stroke-linecap="round">
							<path d="M4 8.5V6a2 2 0 0 1 2-2h2.5"></path>
							<path d="M20 8.5V6a2 2 0 0 0-2-2h-2.5"></path>
							<path d="M4 15.5V18a2 2 0 0 0 2 2h2.5"></path>
							<path d="M20 15.5V18a2 2 0 0 1-2 2h-2.5"></path>
						</g>
						<circle cx="12" cy="12" r="3.1" fill="#4285f4"></circle>
					</svg>
				</span>
			</div>

			<nav class="wws-tabs" aria-hidden="true">
				{TABS.map((tab, i) => <span class:list={['wws-tab', i === 0 && 'is-current']}>{tab}</span>)}
			</nav>

			<p class="wws-places" aria-hidden="true">Places</p>

			<ul class="wws-results" data-results>
				{
					RESULTS.map((result, i) => (
						<li
							class:list={['wws-result', result.featured && 'is-featured']}
							style={`--i:${i}`}
							data-result
							data-featured={result.featured ? '' : undefined}
						>
							<span class="wws-name">{result.name}</span>

							<div class="wws-rating">
								<span class="wws-score" data-score={result.featured ? '' : undefined}>
									{result.rating}
								</span>
								<span class="wws-stars" style={`--fill:${result.fill}`} aria-hidden="true">
									★★★★★<span>★★★★★</span>
								</span>
								<span class="wws-meta">({result.reviews})</span>
							</div>

							<p class="wws-meta wws-result-meta">{result.meta}</p>
						</li>
					))
				}
			</ul>
		</div>
	</SmartphoneFrame>
</div>

<style>
	.wws {
		position: absolute;
		inset: 0;
	}

	/* --------------------------------------------------------------------
	   THE ZOOM. The device is laid out at the size it ends at; the opening
	   state shrinks it by half about its own top edge and drops it far
	   enough to sit centred in the frame, so the whole handset is visible
	   before anything else happens.
	   -------------------------------------------------------------------- */
	.wws :global(.ww-phone) {
		transform: translateY(7%) scale(0.5);
		transition: transform 620ms var(--ease-out);
	}

	.wws.is-zoomed :global(.ww-phone) {
		transform: none;
	}

	/*
	  The screen's own corner radius is large, so the interface is inset well
	  clear of it — tight to the glass, a card's own small radius sits inside
	  the sweep of the phone's and both of them read as mistakes.

	  The colours below are the search page's, kept local to this block: they
	  are a costume for one screenshot and have no business in the site's
	  tokens.
	*/
	.wws-app {
		--g-ink: #202124;
		--g-gray: #5f6368;
		--g-hairline: #dadce0;
		--g-blue: #1a73e8;

		height: 100%;
		padding: 0.9em 1.5em 0;
		display: flex;
		flex-direction: column;
		font-size: 1em;
		font-family: Roboto, Arial, var(--font-sans), sans-serif;
		color: var(--g-ink);
	}

	/* --------------------------------------------------------------------
	   THE FIELD
	   -------------------------------------------------------------------- */
	.wws-searchbar {
		flex: none;
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.62em 0.9em;
		border-radius: var(--radius-pill);
		background-color: var(--ww-white);
		border: 1px solid var(--g-hairline);
		box-shadow: 0 0.08em 0.4em rgb(32 33 36 / 12%);
		color: var(--g-gray);
		overflow: hidden;
	}

	.wws-mark {
		flex: none;
		width: 1.3em;
		height: 1.3em;
	}

	.wws-query {
		display: flex;
		align-items: center;
		flex: 1 1 auto;
		min-width: 0;
		font-size: 0.9em;
		color: var(--g-ink);
		white-space: nowrap;
	}

	.wws-tools {
		flex: none;
		display: flex;
		align-items: center;
		gap: 0.55em;
	}

	.wws-tool {
		width: 1.05em;
		height: 1.05em;
	}

	/* The caret only exists while the query is being written. Before the
	   script starts, and after it finishes, there is nothing blinking on
	   screen to pull the eye off the list. */
	.wws-caret {
		display: none;
		width: 0.09em;
		height: 1.05em;
		margin-left: 0.12em;
		background-color: var(--g-blue);
	}

	.wws.is-typing .wws-caret {
		display: block;
		animation: wws-blink 900ms steps(1, end) infinite;
	}

	@keyframes wws-blink {
		0%,
		49% {
			opacity: 1;
		}
		50%,
		100% {
			opacity: 0;
		}
	}

	/* --------------------------------------------------------------------
	   THE TABS. Chrome, and read as chrome: the hairline under them runs the
	   full width of the glass, which is why they carry the app's padding
	   back out as a negative margin.
	   -------------------------------------------------------------------- */
	.wws-tabs {
		flex: none;
		display: flex;
		gap: 1.35em;
		margin: 0.85em -1.5em 0;
		padding: 0 1.5em;
		border-bottom: 1px solid var(--g-hairline);
		font-size: 0.72em;
		color: var(--g-gray);
		white-space: nowrap;
	}

	.wws-tab {
		padding-bottom: 0.75em;
		border-bottom: 0.22em solid transparent;
	}

	.wws-tab.is-current {
		color: var(--g-blue);
		border-bottom-color: var(--g-blue);
	}

	/* --------------------------------------------------------------------
	   THE LIST
	   -------------------------------------------------------------------- */
	.wws-places {
		flex: none;
		margin: 0.9em 0 0.55em;
		font-size: 0.78em;
		color: var(--g-gray);
	}

	.wws-results {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		min-height: 0;
	}

	.wws-result {
		background-color: var(--ww-white);
		border: 1px solid var(--g-hairline);
		border-radius: var(--radius-input);
		padding: 0.75em 0.9em;
		opacity: 0;
		transform: translateY(0.45em);
		transition:
			opacity 260ms var(--ease-out),
			transform 260ms var(--ease-out),
			border-color 300ms var(--ease-out);
	}

	/* The stagger lives on the state being moved to, because that is where a
	   transition reads its delay from. */
	.wws.is-listed .wws-result {
		opacity: 1;
		transform: none;
		transition-delay: calc(var(--i) * 70ms);
	}

	/* The reorder itself is this one line. The script animates the
	   consequence, because `order` will not transition. */
	.wws.is-sorted .wws-result.is-featured {
		order: -1;
	}

	/*
	  Blue, once, on the business the band is about. It arrives with the list
	  rather than with the rating, because it is what tells the eye where to
	  look before anything moves — and it stays for the rest of the page's
	  life. A ring, not a fill.
	*/
	.wws.is-listed .wws-result.is-featured {
		border-color: var(--g-blue);
	}

	.wws-name {
		display: block;
		font-weight: 600;
		font-size: 0.92em;
		letter-spacing: -0.01em;
	}

	.wws-rating {
		display: flex;
		align-items: baseline;
		gap: 0.35em;
		margin-top: 0.2em;
		font-size: 0.82em;
	}

	.wws-score {
		font-weight: 600;
	}

	.wws-meta {
		font-size: 0.78em;
		color: var(--g-gray);
	}

	.wws-result-meta {
		margin: 0.15em 0 0;
	}

	/* Two identical star rows, the upper one clipped to the rating, so a 3.5
	   becoming a 5.0 is a width transition rather than a redraw. */
	.wws-stars {
		position: relative;
		display: inline-block;
		letter-spacing: 0.05em;
		white-space: nowrap;
		color: var(--g-hairline);
	}

	.wws-stars > span {
		position: absolute;
		inset: 0;
		width: var(--fill, 0%);
		overflow: hidden;
		color: var(--ww-ink-medium);
		transition:
			width 340ms var(--ease-out),
			color 340ms var(--ease-out);
	}

	/* The only yellow on the page, and it arrives on the last beat. */
	.wws.is-rated .wws-result.is-featured .wws-stars > span {
		width: 100%;
		color: #f5b301;
	}
</style>

<script>
	import { initLocalSearch } from './local-search.client';

	initLocalSearch();
</script>
