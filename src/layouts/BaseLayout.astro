---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, BRANDING, CAPABILITIES, SITE } from '../config/site';
// Self-hosted variable fonts from node_modules. `wght.css` is the full weight
// axis in one file per subset; browsers fetch only the subset they need via
// unicode-range. Imported before global.css so the @font-face rules land first.
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
// Russo One is static, one file per subset at a single weight. Only the
// homepage hero uses it, so no page but that one downloads the woff2.
import '@fontsource/russo-one/400.css';
import '../styles/global.css';

interface Props {
	/** Page title. Omit on the homepage to use the full site title verbatim. */
	title?: string;
	description?: string;
	/** Social share image path under /public. Falls back to SITE.ogImage. */
	image?: string;
	/** Alt text for the share image. Falls back to SITE.ogImageAlt. */
	imageAlt?: string;
	/** Override the canonical URL. Defaults to the current path. */
	canonical?: string;
	/** Keep the page out of search results (thank-you pages, drafts…). */
	noindex?: boolean;
	/** Emit Organization structured data. Homepage only. */
	schemaOrg?: boolean;
	bodyClass?: string;
	/**
	 * The browser-chrome colour on mobile. Defaults to cream, which is the
	 * ground of every public page; the client portals set their own, so the
	 * address bar does not sit in the marketing palette above a page that has
	 * left it behind.
	 */
	themeColor?: string;
}

const {
	title,
	description = SITE.description,
	image = SITE.ogImage,
	imageAlt = SITE.ogImageAlt,
	canonical,
	noindex = false,
	schemaOrg = false,
	bodyClass = '',
	themeColor = '#F3F0E8',
}: Props = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.site).href : undefined;

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: SITE.name,
	url: SITE.url,
	// The page's own description, not the site default, so the homepage does
	// not describe itself one way in its meta tag and another in its markup.
	description,
	email: SITE.email,
	logo: new URL(BRAND.mark, SITE.url).href,
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Services',
		// Emitted on the homepage only, so it lists what the homepage sells:
		// the web capabilities, not the photography services. `url` points at
		// the section that describes them, since none of them has a route of
		// its own. Branding is held apart from the three in the page's layout,
		// but it is still work we take on, so it belongs in the catalogue.
		itemListElement: [...CAPABILITIES, BRANDING].map((capability) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: capability.title,
				description: capability.body,
				category: 'Web design and development',
				url: new URL('/#services', SITE.url).href,
			},
		})),
	},
};
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		{/*
		  The hero video is served from this origin, so the handshake to it sits on
		  the critical path of the one asset the homepage most wants early. Opening
		  it here overlaps the DNS lookup and TLS negotiation with the rest of head
		  parsing instead of paying for them after the <source> is reached.

		  Deliberately no crossorigin: browsers pool CORS and non-CORS connections
		  separately, and the <video> carries no crossorigin attribute, so it
		  fetches in non-CORS mode. Adding it here would warm the CORS pool and
		  leave the video to open a second connection of its own — the opposite of
		  the point. If the element ever gains crossorigin (a canvas reading frames
		  back, say), this hint has to gain it at the same time.

		  Every page pays for the hint, but only the homepage has the hero. The
		  cost of a spare warm socket is small next to threading a per-page flag
		  through the layout for it.
		*/}
		<link rel="preconnect" href="https://assets.wellworncreative.com" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<meta name="theme-color" content={themeColor} />

		{/* Open Graph */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={SITE.locale} />
		{
			ogImageUrl && (
				<>
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:width" content={String(SITE.ogImageWidth)} />
					<meta property="og:image:height" content={String(SITE.ogImageHeight)} />
					<meta property="og:image:alt" content={imageAlt} />
				</>
			)
		}

		{/* Twitter / X */}
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{
			ogImageUrl && (
				<>
					<meta name="twitter:image" content={ogImageUrl} />
					<meta name="twitter:image:alt" content={imageAlt} />
				</>
			)
		}

		{
			schemaOrg && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(organizationSchema)}
				/>
			)
		}
	</head>

	<body class:list={['flex min-h-screen flex-col', bodyClass]}>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:bg-charcoal focus:px-5 focus:py-3 focus:font-display focus:text-xs focus:font-semibold focus:uppercase focus:tracking-label focus:text-cream"
		>
			Skip to content
		</a>

		{/*
		  The site header and footer are the fallback rather than the rule. A page
		  that has its own chrome — the client portals, which are not part of the
		  marketing site and must not be dressed as it — passes its own into these
		  slots, and every other page gets the pair below without knowing the
		  slots exist. Kept here rather than in a second layout so the head, the
		  skip link and the flex column stay written once.
		*/}
		<slot name="header"><Header /></slot>

		<main id="main" class="flex-1">
			<slot />
		</main>

		<slot name="footer"><Footer /></slot>
	</body>
</html>
