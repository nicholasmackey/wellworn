---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BRAND, SERVICES, SITE } from '../config/site';
/*
 * Three typefaces, for every page this layout renders. WWBlock, the display
 * face, is self-hosted: its @font-face rule rides in with global.css below and
 * the file is preloaded in the head. The other two come from Google Fonts,
 * linked in the head below — see FONTS_HREF.
 *
 * There is no per-page opt-out and no second set. The /projects/* routes used
 * to turn these off and import three Fontsource families of their own, which
 * is what made a client portal look like a different studio's product; they
 * are set in the same three as everything else now.
 */
import '../styles/global.css';

interface Props {
	/** Page title. Omit on the homepage to use the full site title verbatim. */
	title?: string;
	description?: string;
	/** Social share image path under /public. Falls back to SITE.ogImage. */
	image?: string;
	/** Alt text for the share image. Falls back to SITE.ogImageAlt. */
	imageAlt?: string;
	/** Override the canonical URL. Defaults to the current path. */
	canonical?: string;
	/** Keep the page out of search results (thank-you pages, drafts…). */
	noindex?: boolean;
	/** Emit Organization structured data. Homepage only. */
	schemaOrg?: boolean;
	bodyClass?: string;
	/**
	 * Inline declarations for <body>. The one caller is the questionnaire route,
	 * which uses it to set the CSS custom properties a client theme resolves to —
	 * see lib/questionnaire/theme.ts. Nothing here is author-supplied: the string
	 * is built from a fixed list of property names and hex values the definition
	 * schema has already constrained.
	 */
	bodyStyle?: string;
	/**
	 * The browser-chrome colour on mobile. Defaults to white, which is the
	 * ground the marketing pages open on; the client portals set their own, so
	 * the address bar does not sit in the marketing palette above a page that
	 * has left it behind.
	 */
	themeColor?: string;
}

const {
	title,
	description = SITE.description,
	image = SITE.ogImage,
	imageAlt = SITE.ogImageAlt,
	canonical,
	noindex = false,
	schemaOrg = false,
	bodyClass = '',
	bodyStyle,
	themeColor = '#ffffff',
}: Props = Astro.props;

/*
 * The site's two Google-hosted typefaces, in one request. The third, WWBlock,
 * is self-hosted — see fonts.css.
 *
 * Only the weights the design system actually declares: Inter at
 * 400/500/600, JetBrains Mono at 500. base.css sets
 * `font-synthesis: none`, so asking any element for a weight outside this list
 * gets the nearest real one rather than a faked one — which is the point of
 * keeping the two lists in step.
 *
 * `display=swap` shows the fallback stack immediately and swaps when the file
 * lands, so a slow font never leaves the hero blank.
 *
 * Retiring the last two the way WWBlock was retired means deleting the two
 * preconnects and this link and adding two more @font-face rules, and
 * changing nothing else: every component reaches for --font-display /
 * --font-sans / --font-mono, and none of them names a family.
 */
const FONTS_HREF =
	'https://fonts.googleapis.com/css2' +
	'?family=Inter:wght@400;500;600' +
	'&family=JetBrains+Mono:wght@500' +
	'&display=swap';

const pageTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site);
const ogImageUrl = image ? new URL(image, Astro.site).href : undefined;

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: SITE.name,
	url: SITE.url,
	// The page's own description, not the site default, so the homepage does
	// not describe itself one way in its meta tag and another in its markup.
	description,
	email: SITE.email,
	logo: new URL(BRAND.mark, SITE.url).href,
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Services',
		// Emitted on the homepage only, so it lists exactly what the homepage
		// sells — the five service cards, in the order they appear
		// there. `url` points at that section, since none of them has a route
		// of its own yet.
		itemListElement: SERVICES.map((service) => ({
			'@type': 'Offer',
			itemOffered: {
				'@type': 'Service',
				name: service.title,
				description: service.body,
				category: 'Web design and development',
				url: new URL('/#services', SITE.url).href,
			},
		})),
	},
};
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		{/*
		  The hero video is served from this origin, so the handshake to it sits on
		  the critical path of the one asset the homepage most wants early. Opening
		  it here overlaps the DNS lookup and TLS negotiation with the rest of head
		  parsing instead of paying for them after the <source> is reached.

		  Deliberately no crossorigin: browsers pool CORS and non-CORS connections
		  separately, and the <video> carries no crossorigin attribute, so it
		  fetches in non-CORS mode. Adding it here would warm the CORS pool and
		  leave the video to open a second connection of its own — the opposite of
		  the point. If the element ever gains crossorigin (a canvas reading frames
		  back, say), this hint has to gain it at the same time.

		  Every page pays for the hint, but only the homepage has the hero. The
		  cost of a spare warm socket is small next to threading a per-page flag
		  through the layout for it.
		*/}
		<link rel="preconnect" href="https://assets.wellworncreative.com" />

		{/*
		  Google Fonts is two origins: the stylesheet comes from googleapis and
		  the WOFF2 files it names come from gstatic, so the second handshake
		  cannot start until the first stylesheet has parsed. Warming both here
		  overlaps them with the rest of head parsing.

		  The gstatic hint carries crossorigin and the googleapis one does not,
		  and that asymmetry is deliberate: font files are always fetched in CORS
		  mode, stylesheets are not, and browsers pool the two kinds of
		  connection separately. A hint in the wrong mode warms a socket nothing
		  will use.
		*/}
		{/*
		  The display face, fetched from our own origin rather than discovered
		  three files deep — the stylesheet has to parse before anything learns
		  this file exists, and it sets the one headline above the fold. Same
		  origin, so no crossorigin attribute would be needed for the fetch, but
		  a preload for a font is always a CORS-mode fetch and a hint that does
		  not match the request it is meant to satisfy downloads the file twice.
		*/}
		<link rel="preload" href="/fonts/wwblock-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS_HREF} />

		{/*
		  THE TEXT ENTRANCE'S ONE PIECE OF INLINE WORK — see styles/reveal.css.

		  The entrance starts from a hidden state, and a hidden state written
		  unconditionally into the stylesheet is a page that stays blank when
		  the script does not arrive. So the stylesheet's rules are all behind
		  this attribute and the attribute is set here, in the head, before the
		  first heading is parsed: no JavaScript, no attribute, no hidden text,
		  and no flash of the words appearing before they are hidden either.

		  The timeout is the same argument one step further out. If the module
		  bundle fails to load or throws, nothing ever claims the attribute and
		  it comes back off three seconds later, leaving every heading visible.
		*/}
		<script is:inline>
			(function () {
				var root = document.documentElement;
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				root.setAttribute('data-text-reveal', '');
				setTimeout(function () {
					if (!root.hasAttribute('data-text-reveal-ready')) root.removeAttribute('data-text-reveal');
				}, 3000);
			})();
		</script>

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl.href} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<meta name="theme-color" content={themeColor} />

		{/* Open Graph */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:locale" content={SITE.locale} />
		{
			ogImageUrl && (
				<>
					<meta property="og:image" content={ogImageUrl} />
					<meta property="og:image:width" content={String(SITE.ogImageWidth)} />
					<meta property="og:image:height" content={String(SITE.ogImageHeight)} />
					<meta property="og:image:alt" content={imageAlt} />
				</>
			)
		}

		{/* Twitter / X */}
		<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{
			ogImageUrl && (
				<>
					<meta name="twitter:image" content={ogImageUrl} />
					<meta name="twitter:image:alt" content={imageAlt} />
				</>
			)
		}

		{
			schemaOrg && (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(organizationSchema)}
				/>
			)
		}
	</head>

	<body class:list={['ww-page', bodyClass]} style={bodyStyle}>
		<a href="#main" class="ww-skip-link">Skip to content</a>

		{/*
		  The site header and footer are the fallback rather than the rule. A page
		  with chrome of its own — a client portal, whose masthead is the client's
		  own lockup and whose footer is one line of contact — passes it into these
		  slots, and every other page gets the pair below without knowing the slots
		  exist. Kept here rather than in a second layout so the head, the skip
		  link and the flex column stay written once.
		*/}
		<slot name="header"><Header /></slot>

		<main id="main" class="ww-main">
			<slot />
		</main>

		<slot name="footer"><Footer /></slot>
	</body>
</html>
